<toad:ToadWindow
    x:Class="ClassifierCode.Views.ProfileFoldersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toad="urn:toaddesign"
    Title="Папки профилей"
    WindowStartupLocation="CenterOwner"
    Height="360"
    Width="560"
    TitleIcon="Folder">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="20,6,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Общие папки с профилями (например, сетевая папка отдела) — по папке в строке. Свои профили лежат в личной папке и видны всегда." />
            <toad:TextBox x:Name="FoldersBox" Grid.Row="1" AcceptsReturn="True" FontFamily="Consolas" Placeholder="\\server\BIM\Классификаторы" />
            <TextBlock x:Name="PersonalText" Grid.Row="2" Margin="0,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <toad:Button Content="Отмена" Click="OnCancel" />
            <toad:Button Margin="8,0,0,0" Content="Сохранить" Icon="Check" Variant="Filled" Click="OnOk" />
        </StackPanel>
    </Grid>
</toad:ToadWindow>
