<toad:ToadWindow
    x:Class="QuantityCheck.Views.QuantityCheckView"
    xmlns:toad="urn:toaddesign"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="Записать количество"
    Height="300"
    Width="450"
    MinHeight="250"
    MinWidth="400"
    TitleIcon="CirclePlus">
    
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        
            <TextBlock  Text="Введите имя параметра для заполнения количества" FontWeight="Bold" Margin="10,0,0,10" />
            
            <toad:TextBox Grid.Row="1" Text="{Binding ParameterName, Mode=TwoWay}"
                        Placeholder="Имя параметра"/>
            
            <TextBlock Grid.Row="2" Text="Введите запас в процентах для длиновых элементов" FontWeight="Bold" Margin="10,0,0,10" />
            
            <toad:TextBox Grid.Row="3" Text="{Binding Reverse, Mode=TwoWay}"
                        Placeholder="Запас в процентах"/>
            
            
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <toad:Button Content="Запуск"
                           Icon="Rocket"
                           Command="{Binding WriteQuantityCommand}"
                           Variant="Filled"
                           Margin="10,0,0,0" />
                    
            </StackPanel>
        </Grid>
        

        <!-- Переключатель темы -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10">
            <toad:Switch Content="Тёмная тема"
                IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
        </StackPanel>

    </Grid>
</toad:ToadWindow>