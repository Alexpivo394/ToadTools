<Project Sdk="Nice3point.Revit.Sdk/6.3.2">

    <ItemGroup>
        <PackageReference Include="Alexpivo394.Revit.ParamCheck"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <!-- На .NET входит в рантайм -->
        <PackageReference Include="System.Text.Json" Condition="'$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETFramework'"/>
    </ItemGroup>

    <!-- DPAPI для токена ToadFlow; с .NET 10 (Revit 2027) входит в Windows Desktop -->
    <ItemGroup Condition="'$(RevitVersion)' &lt; '2027'">
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
    </ItemGroup>

    <!-- HttpClient для отправки итогов в ToadFlow; на .NET входит в рантайм -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETFramework'">
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ToadTools.UI\ToadTools.UI.csproj"/>
        <ProjectReference Include="..\ToadTools.Connection\ToadTools.Connection.csproj"/>
    </ItemGroup>

</Project>
