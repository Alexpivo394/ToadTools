<toad:ToadWindow
    x:Class="WorksetCheck.Views.WorksetCheckView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toad="urn:toaddesign"
    xmlns:viewModels="clr-namespace:WorksetCheck.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:WorksetCheckViewModel}"
    mc:Ignorable="d"
    Title="Проверка рабочих наборов"
    Width="560"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    TitleIcon="ListCheck">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,4,0,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- ReSharper disable Xaml.DynamicResourceError -->
        <Border Grid.Row="1" Margin="10,0,10,10" CornerRadius="5" Padding="12,4,12,12"
                Background="{DynamicResource Toad.Brush.Surface}"
                BorderBrush="{DynamicResource Toad.Brush.Accent}" BorderThickness="1">
            <!-- ReSharper restore Xaml.DynamicResourceError -->
            <StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                           Text="Проверяется открытая модель. Имена рабочих наборов подставлены автоматически — проверьте их и при необходимости поправьте." />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                           Text="Каждая связь Revit должна лежать в своём РН «#Связь имя_файла» — это проверяется всегда." />

                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="РН связей DWG" />
                    <Run Text="{Binding CadSource, Mode=OneWay}" FontWeight="Normal" FontStyle="Italic" />
                </TextBlock>
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding Worksets}"
                          Text="{Binding CadWorkset, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding CadHint}" />

                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="РН осей и уровней" />
                    <Run Text="{Binding GridsSource, Mode=OneWay}" FontWeight="Normal" FontStyle="Italic" />
                </TextBlock>
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding Worksets}"
                          Text="{Binding GridsWorkset, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding GridsHint}" />

                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="РН заданий на отверстия" />
                    <Run Text="{Binding OpeningsSource, Mode=OneWay}" FontWeight="Normal" FontStyle="Italic" />
                </TextBlock>
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding Worksets}"
                          Text="{Binding OpeningsWorkset, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding OpeningsHint}" />
            </StackPanel>
        </Border>

        <!-- ReSharper disable Xaml.DynamicResourceError -->
        <Border Grid.Row="2" Background="{DynamicResource Toad.Brush.Surface}" Height="48">
            <!-- ReSharper restore Xaml.DynamicResourceError -->
            <DockPanel Margin="10,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <toad:Switch Content="Тёмная тема" IsChecked="{Binding DarkTheme, Mode=TwoWay}" />
                </StackPanel>
                <toad:Button Content="Проверить"
                           Icon="PlayerPlay"
                           Command="{Binding StartCommand}"
                           IsDefault="True"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Variant="Filled" />
            </DockPanel>
        </Border>
    </Grid>
</toad:ToadWindow>
