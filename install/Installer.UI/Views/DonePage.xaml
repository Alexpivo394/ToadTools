<UserControl x:Class="Installer.UI.Views.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toad="urn:toaddesign">
    <UserControl.Resources>
        <ResourceDictionary Source="/ToadTools.Installer.UI;component/Views/Shared.xaml" />
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="{StaticResource FooterMargin}" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="-10,0,0,0"
                        Visibility="{Binding ShowLinks, Converter={StaticResource Visible}}">
                <toad:Button Variant="Subtle" Padding="10,0" Content="Что нового" Command="{Binding OpenCommand}" CommandParameter="release" />
                <toad:Button Variant="Subtle" Padding="10,0" Content="Справка" Command="{Binding OpenCommand}" CommandParameter="help" />
            </StackPanel>
            <toad:Button DockPanel.Dock="Right" Variant="Filled" Content="Готово" Command="{Binding CloseCommand}"
                         IsDefault="True" IsCancel="True" />
        </DockPanel>

        <StackPanel Margin="{StaticResource BodyMargin}" VerticalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,14"
                    Background="{DynamicResource Toad.Brush.AccentLight}">
                <toad:Icon Symbol="Check" Width="34" Height="34" StrokeThickness="2.5"
                           Foreground="{DynamicResource Toad.Brush.AccentLightText}" />
            </Border>
            <TextBlock Text="{Binding DoneTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Text="{Binding DoneText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" LineHeight="21"
                       Foreground="{DynamicResource Toad.Brush.TextDimmed}" />
        </StackPanel>
    </DockPanel>
</UserControl>
