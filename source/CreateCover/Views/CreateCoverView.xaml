<toad:ToadWindow
    x:Class="CreateCover.Views.CreateCoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    mc:Ignorable="d"
    Title="Разместить крышки"
    WindowStartupLocation="CenterScreen"
    Height="400"
    Width="800"
    MinHeight="350"
    MinWidth="800"
    TitleIcon="CirclePlus">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title Bar -->
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Правила переноса параметров" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" />
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Параметры лотка" FontWeight="Regular" Margin="0,0,0,0" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Параметры крышки" FontWeight="Regular" Margin="0,0,0,0" HorizontalAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MinHeight="150">
                <ListView
                    ItemsSource="{Binding Models}"
                    HorizontalContentAlignment="Stretch"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox  
                                    ItemsSource="{Binding TrayParams}" 
                                    DisplayMemberPath="Name"
                                    SelectedItem="{Binding SelectedTrayParam, Mode=TwoWay}"
                                    Height="35"
                                    Margin="0,0,0,0"/>
                                    
                                    
                                <ComboBox
                                    Grid.Column="1" ItemsSource="{Binding CoverParams}" 
                                    DisplayMemberPath="Name"
                                    SelectedItem="{Binding SelectedCoverParam, Mode=TwoWay}"
                                    Height="35"
                                    Margin="10,0,0,0"/>
                                    
                                <toad:Button
                                    Grid.Column="2"
                                    Icon="Trash"
                                    Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Variant="Subtle"
                                    VerticalAlignment="Stretch"
                                    Margin="10,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <toad:Button Content="Добавить"
                           Icon="CirclePlus"
                           Command="{Binding AddModelCommand}"
                           Margin="0,0,0,0" />
                    
                <toad:Button Content="Запуск"
                           Icon="Rocket"
                           Command="{Binding StartCommand}"
                           Variant="Filled"
                           Margin="10,0,0,0" />
                    
            </StackPanel>
        </Grid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10">
            <toad:Switch Content="Тёмная тема"
                IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
        </StackPanel>
    </Grid>
</toad:ToadWindow>