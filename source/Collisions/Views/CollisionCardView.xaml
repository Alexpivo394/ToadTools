<UserControl
    x:Class="Collisions.Views.CollisionCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Collisions.ViewModels"
    xmlns:views="clr-namespace:Collisions.Views"
    xmlns:conv="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=vm:CardViewModel}"
    mc:Ignorable="d"
    d:DesignWidth="380">

    <UserControl.Resources>
        <DataTemplate x:Key="ParameterTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,4,4">
            <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap">
                <Run Text="{Binding Number, StringFormat=№ {0}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{Binding Depth, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Assignee, StringFormat=Кто правит: {0}}" FontSize="11" Opacity="0.75" />

            <TextBlock Text="{Binding NavigateMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Visibility="{Binding NavigateMessage, Converter={views:TextVisibilityConverter}}" />
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding Error, Converter={views:TextVisibilityConverter}}" />

            <!-- Действия: те же, что в веб-карточке -->
            <WrapPanel Margin="0,8,0,0">
                <ui:Button Content="Беру" Command="{Binding TakeCommand}" Margin="0,0,6,6"
                           Visibility="{Binding CanTake, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <ui:Button Content="Передать…" Command="{Binding PassCommand}" Margin="0,0,6,6"
                           Visibility="{Binding CanPass, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <ui:Button Content="Исправлена" ToolTip="Исправлена (ожидает подтверждения следующим прогоном)" Command="{Binding FixedCommand}"
                           Margin="0,0,6,6" Visibility="{Binding CanFixed, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <ui:Button Content="Фиктивная…" Command="{Binding FakeCommand}" Margin="0,0,6,6"
                           Visibility="{Binding CanFake, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <ui:Button Content="Снять «фиктивная»" Command="{Binding UnfakeCommand}" Margin="0,0,6,6"
                           Visibility="{Binding CanUnfake, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <ui:Button Content="Примечание…" Command="{Binding NoteCommand}" Margin="0,0,6,6"
                           Visibility="{Binding CanNote, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <ui:Button Content="Открыть в 3D" ToolTip="Просмотрщик коллизии в браузере" Command="{Binding OpenIn3DCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Text="{Binding Hint}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                       Visibility="{Binding Hint, Converter={views:TextVisibilityConverter}}" />

            <Border CornerRadius="4" Margin="0,8,0,0" MinHeight="120" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <Grid>
                    <TextBlock Text="картинка рисуется…" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="320" />
                </Grid>
            </Border>

            <TextBlock Text="Свой элемент" FontWeight="SemiBold" Margin="0,10,0,2" />
            <TextBlock Text="{Binding Own}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding OwnParameters}" ItemTemplate="{StaticResource ParameterTemplate}" />

            <TextBlock Text="Второй элемент" FontWeight="SemiBold" Margin="0,10,0,2" />
            <TextBlock Text="{Binding Other}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding OtherParameters}" ItemTemplate="{StaticResource ParameterTemplate}" />

            <TextBlock Text="Лента" FontWeight="SemiBold" Margin="0,10,0,2" />
            <ItemsControl ItemsSource="{Binding Feed}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
