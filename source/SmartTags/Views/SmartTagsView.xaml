<toad:ToadWindow
    x:Class="SmartTags.Views.SmartTagsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:themes="clr-namespace:ToadTools.UI.Services;assembly=ToadTools.UI"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewModels="clr-namespace:SmartTags.ViewModels"
    xmlns:models="clr-namespace:SmartTags.Models"
    xmlns:layout="clr-namespace:SmartTags.Layout"
    xmlns:converters="clr-namespace:SmartTags.Converters"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:SmartTagsViewModel}"
    mc:Ignorable="d"
    Title="Умные выноски"
    WindowStartupLocation="CenterScreen"
    Height="860"
    Width="940"
    MinHeight="620"
    MinWidth="820"
    TitleIcon="Tags"
    Fill="Background">

    <toad:ToadWindow.Resources>
        <!-- Dense window: buttons and fields 34 px high, as in the large ParamChecker windows -->
        <sys:Double x:Key="Toad.Size.Control">34</sys:Double>
    </toad:ToadWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title Bar -->

        <!-- Content -->
        <Grid Grid.Row="1" Margin="16,4,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="10,0,0,10"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding ViewDescription}" />

            <toad:Alert Grid.Row="1"
                        Margin="0,0,0,10"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="{Binding ShowLockWarning, Mode=OneWay}"
                        Content="{Binding LockWarning}" />

            <!-- Scope: whole view or selected elements -->
            <toad:Card Grid.Row="2"
                     Margin="0,0,0,10"
                     Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <toad:Icon Symbol="Click" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ScopeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <toad:Button Content="{Binding ScopeButtonText}"
                                   Command="{Binding ToggleScopeCommand}"
                                   Visibility="{Binding HasSelection, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}"
                                   MinWidth="140"
                                   Margin="0,0,8,0" />
                        <toad:Button Content="Выбрать на виде"
                                   Icon="Pointer"
                                   ToolTip="Окно скроется — выберите элементы на виде как обычно в Revit и нажмите «Готово» на панели выбора"
                                   Command="{Binding PickElementsCommand}" />
                    </StackPanel>
                </Grid>
            </toad:Card>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- Categories and tag types -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Категории и марки" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <toad:Button Content="Выбрать все" Variant="Subtle" Command="{Binding SelectAllCommand}" />
                            <toad:Button Content="Снять все" Variant="Subtle" Command="{Binding ClearAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <toad:Card Grid.Row="1" Padding="8,6" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:CategoryRowViewModel}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="250" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      MinWidth="0"
                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="4,0,10,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Title}"
                                                       ToolTip="{Binding Title}" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding TagTypes}"
                                                      SelectedItem="{Binding SelectedTagType}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEnabled="{Binding IsSelected}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </toad:Card>

                    <!-- Options for pipes, ducts, trays -->
                    <StackPanel Grid.Row="2"
                                Margin="10,10,0,0"
                                Visibility="{Binding ShowRunOptions, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Не маркировать участки (трассы) короче, мм" VerticalAlignment="Center" />
                            <toad:TextBox Grid.Column="1" Width="90"
                                        Text="{Binding MinRunLength, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <CheckBox Margin="0,6,0,0"
                                  Content="Маркировать вертикальные участки (стояки)"
                                  IsChecked="{Binding TagVerticalRuns}" />
                        <TextBlock Margin="0,8,0,2" Text="Марки на трубах, воздуховодах, лотках:" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="RunMode"
                                         Content="Трасса целиком"
                                         ToolTip="Одна марка на трассу: участки одного размера и системы, соединённые отводами, муфтами, арматурой или прямым проходом тройника. Ответвление тройника — отдельная трасса. Если текст марки вдоль трассы меняется (например, расход), подпись получает каждая часть со своим текстом."
                                         IsChecked="{Binding RunMode, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunTagMode.Routes}}" />
                            <RadioButton GroupName="RunMode"
                                         Margin="12,0,0,0"
                                         Content="Прямой участок"
                                         ToolTip="Марка на каждый прямой участок: соосные куски одного размера и системы, соединённые напрямую или муфтой."
                                         IsChecked="{Binding RunMode, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunTagMode.Runs}}" />
                            <RadioButton GroupName="RunMode"
                                         Margin="12,0,0,0"
                                         Content="Каждый элемент"
                                         ToolTip="Марка на каждую трубу, воздуховод, лоток — даже если они идут подряд по одной прямой."
                                         IsChecked="{Binding RunMode, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunTagMode.Each}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Placement -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Уже стоящие марки" FontWeight="Bold" Margin="10,0,0,5" />
                    <toad:Card Padding="12,8">
                        <StackPanel>
                            <RadioButton GroupName="Existing"
                                         Content="Пропустить подписанные элементы"
                                         IsChecked="{Binding ExistingMode, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:ExistingTagMode.Skip}}" />
                            <RadioButton GroupName="Existing"
                                         Content="Переразместить вместе с новыми"
                                         IsChecked="{Binding ExistingMode, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:ExistingTagMode.Relayout}}" />
                            <RadioButton GroupName="Existing"
                                         Content="Удалить и создать заново"
                                         IsChecked="{Binding ExistingMode, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:ExistingTagMode.Recreate}}" />
                        </StackPanel>
                    </toad:Card>

                    <TextBlock Text="Размещение" FontWeight="Bold" Margin="10,10,0,5" />
                    <toad:Card Padding="12,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Длина выноски, мм" VerticalAlignment="Center" />
                                <toad:TextBox Grid.Row="0" Grid.Column="1" Width="80"
                                            Text="{Binding PreferredLeader, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="Не длиннее, мм" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <toad:TextBox Grid.Row="1" Grid.Column="1" Width="80" Margin="0,6,0,0"
                                            Text="{Binding MaxLeader, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox Margin="0,8,0,0"
                                      ToolTip="Соседние элементы с одинаковым текстом марки (например, решётки одного типоразмера и расхода) подписываются один раз: выноски от всех элементов сходятся к одной подписи. Трубы и воздуховоды так не объединяются."
                                      IsChecked="{Binding ShareLabels}">
                                <TextBlock Text="Одинаковые марки рядом — одной подписью" TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Visibility="{Binding ShowSide, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                                <TextBlock Text="Сторона марки" Margin="0,12,0,4"
                                           ToolTip="Куда от элемента уходит выноска. На другую сторону марка уходит, только если на заданной для неё нет места." />
                                <WrapPanel>
                                    <RadioButton GroupName="Side" MinWidth="0" Margin="0,0,10,0" Content="Авто"
                                                 ToolTip="Сторону выбирает плагин — туда, где свободнее"
                                                 IsChecked="{Binding Side, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static layout:TagSide.Auto}}" />
                                    <RadioButton GroupName="Side" MinWidth="0" Margin="0,0,10,0" Content="Сверху"
                                                 IsChecked="{Binding Side, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static layout:TagSide.Top}}" />
                                    <RadioButton GroupName="Side" MinWidth="0" Margin="0,0,10,0" Content="Снизу"
                                                 IsChecked="{Binding Side, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static layout:TagSide.Bottom}}" />
                                    <RadioButton GroupName="Side" MinWidth="0" Margin="0,0,10,0" Content="Слева"
                                                 IsChecked="{Binding Side, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static layout:TagSide.Left}}" />
                                    <RadioButton GroupName="Side" MinWidth="0" Content="Справа"
                                                 IsChecked="{Binding Side, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static layout:TagSide.Right}}" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Text="Качество раскладки" Margin="0,12,0,4" />
                            <Slider Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                    TickPlacement="BottomRight" Value="{Binding Quality}" />
                            <Grid Opacity="0.7">
                                <TextBlock Text="Быстро" HorizontalAlignment="Left" FontSize="12" />
                                <TextBlock Text="Стандарт" HorizontalAlignment="Center" FontSize="12" />
                                <TextBlock Text="Максимум" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                                       Text="Все отмеченные категории раскладываются за один проход — марки разных категорий не перекроют друг друга." />
                        </StackPanel>
                    </toad:Card>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Advanced -->
            <toad:CardExpander Grid.Row="4"
                             Margin="0,10,0,0"
                             Header="Расширенные настройки"
                             Icon="Adjustments"
                             IsExpanded="{Binding AdvancedExpanded}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Зазор между марками, мм" VerticalAlignment="Center" />
                            <toad:TextBox Grid.Row="0" Grid.Column="1" Width="80"
                                        Text="{Binding Gap, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Text="Минимальная длина выноски, мм" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <toad:TextBox Grid.Row="1" Grid.Column="1" Width="80" Margin="0,6,0,0"
                                        Text="{Binding MinLeader, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <CheckBox Content="Не ставить текст поверх элементов" IsChecked="{Binding AvoidTextOverElements}" />
                        <CheckBox Content="Не выходить за подрезку вида" IsChecked="{Binding UseCrop}" Margin="0,4,0,0" />
                        <CheckBox Content="Писать журнал (для разбора проблем)" IsChecked="{Binding WriteLog}" Margin="0,4,0,0" />
                        <toad:Button Content="Сбросить настройки"
                                   Icon="ArrowBackUp"
                                   Command="{Binding ResetSettingsCommand}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </toad:CardExpander>

            <toad:Alert Grid.Row="5"
                        Margin="0,10,0,0"
                        Severity="Error"
                        IsClosable="False"
                        IsOpen="{Binding HasError, Mode=OneWay}"
                        Content="{Binding Error}" />
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="16,14,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <toad:Switch Content="Тёмная тема" VerticalAlignment="Center"
                         IsChecked="{Binding IsDark, Source={x:Static themes:ThemePreference.Instance}}" />
            </StackPanel>
            <toad:Button Grid.Column="1"
                       Content="Запустить"
                       Icon="Rocket"
                       Command="{Binding StartCommand}"
                       Variant="Filled" />
        </Grid>
    </Grid>
</toad:ToadWindow>
