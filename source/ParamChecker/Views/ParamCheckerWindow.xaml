<toad:ToadWindow
    x:Class="ParamChecker.Views.ParamCheckerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    xmlns:views="clr-namespace:ParamChecker.Views"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
    mc:Ignorable="d"
    Title="ParamChecker"
    WindowStartupLocation="CenterScreen"
    Height="780"
    Width="1200"
    MinHeight="600"
    MinWidth="960"
    TitleIcon="FileSearch"
    Fill="Background">

    <toad:ToadWindow.Resources>
        <!-- Dense window: buttons and fields 34 px high, as in the large ParamChecker windows -->
        <sys:Double x:Key="Toad.Size.Control">34</sys:Double>
    </toad:ToadWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <Grid Grid.Row="1" Margin="16,4,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Профили -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,0,8" MinHeight="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Профили" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <toad:Button Content="Добавить" Icon="Plus" Variant="Subtle"
                                   Command="{Binding AddProfileCommand}" />
                        <toad:Button Icon="Trash" Tone="Danger" ToolTip="Удалить все профили"
                                   Command="{Binding ClearProfilesCommand}" />
                    </StackPanel>
                </Grid>

                <toad:Card Grid.Row="1" Padding="4" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalContentAlignment="Stretch"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ProfileViewModel}">
                                    <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}" ><MenuItem.Icon><toad:Icon Symbol="Copy" /></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="Удалить" Command="{Binding RemoveCommand}"  toad:Theme.Tone="Danger"><MenuItem.Icon><toad:Icon Symbol="Trash" /></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled}" ToolTip="Проверять при запуске" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                       ToolTip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Toad.Brush.TextDimmed}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Профилей нет.&#10;Добавьте профиль или загрузите&#10;кнопкой «Импорт»."
                                   TextAlignment="Center" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Profiles.Count, Converter={views:ZeroVisibleConverter}}" />
                    </Grid>
                </toad:Card>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <UniformGrid Columns="2">
                        <toad:Button Content="Импорт" Icon="Download" HorizontalAlignment="Stretch"
                                   ToolTip="Загрузить профили из файла .json (в том числе из прежних версий ParamChecker)"
                                   Command="{Binding ImportCommand}" />
                        <toad:Button Content="Экспорт" Icon="Upload" HorizontalAlignment="Stretch" Margin="8,0,0,0"
                                   ToolTip="Сохранить все профили в файл .json — чтобы поделиться с коллегами"
                                   Command="{Binding ExportCommand}" />
                    </UniformGrid>
                    <toad:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="Настройки"
                               Icon="AdjustmentsHorizontal"
                               Variant="{Binding IsSettingsOpen, Converter={views:SelectedAppearanceConverter}}"
                               Command="{Binding ToggleSettingsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Профиль или настройки -->
            <Grid Grid.Column="2">
                <views:ProfileView DataContext="{Binding SelectedProfile}"
                                   Visibility="{Binding DataContext.ShowProfile, RelativeSource={RelativeSource AncestorType=Window}, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                <views:SettingsView Visibility="{Binding IsSettingsOpen, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                    <toad:Icon Symbol="FileSearch" Width="48" Height="48" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,12,0,0" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="Профиль — это модели и правила их проверки. Удобно заводить по профилю на раздел или объект." />
                    <toad:Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="Создать профиль"
                               Icon="Plus" Variant="Filled" Command="{Binding AddProfileCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Подвал -->
        <Grid Grid.Row="2" Margin="16,14,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding RunHint}"
                       Foreground="{DynamicResource Toad.Brush.TextDimmed}" />
            <toad:Button Grid.Column="1" Margin="0,0,8,0"
                       Content="Проверить открытую модель"
                       Icon="FileCheck"
                       ToolTip="Проверить модель, открытую сейчас в Revit, по правилам выбранного профиля — без открытия моделей профиля"
                       Command="{Binding RunActiveCommand}" />
            <toad:Button Grid.Column="2"
                       Content="{Binding RunText}"
                       Icon="PlayerPlay"
                       ToolTip="Открыть по очереди модели отмеченных профилей и проверить их"
                       Command="{Binding RunCommand}"
                       Variant="Filled" />
        </Grid>
    </Grid>
</toad:ToadWindow>
