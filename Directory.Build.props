<Project>

    <!-- Global build configuration -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>
    
    <!-- Polyfills configuration -->
    <PropertyGroup>
        <PolyArgumentExceptions>true</PolyArgumentExceptions>
    </PropertyGroup>

    <!-- Пакеты ядра семейств (ToadFamilyManager) до публикации на nuget.org берутся из соседней папки output, если она есть -->
    <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\ToadFamilyManager\output')">
        <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)..\ToadFamilyManager\output</RestoreAdditionalProjectSources>
    </PropertyGroup>

    <!-- Global usings -->
    <ItemGroup>
        <Using Include="JetBrains.Annotations"/>
    </ItemGroup>

</Project>