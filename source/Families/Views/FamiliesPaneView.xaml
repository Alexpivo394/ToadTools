<UserControl
    x:Class="Families.Views.FamiliesPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:vm="clr-namespace:Families.ViewModels"
    xmlns:views="clr-namespace:Families.Views"
    d:DataContext="{d:DesignInstance Type=vm:FamiliesPaneViewModel}"
    mc:Ignorable="d"
    d:DesignWidth="380" d:DesignHeight="760"
    Background="{DynamicResource Toad.Brush.Background}"
    Foreground="{DynamicResource Toad.Brush.Text}"
    toad:Theme.IsRoot="True">

    <UserControl.Resources>
        <!-- Вкладки в теме ToadDesign: подпись и подсветка выбранной, без системной рамки -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="10,4" Margin="0,0,4,0" CornerRadius="4" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Toad.Brush.Hover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: заявки с новостями и «Обновить» -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <toad:Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
            <toad:Loader DockPanel.Dock="Right" Width="18" Height="18" Visibility="{Binding IsBusy, Converter={views:ShownConverter}}" />
            <ItemsControl ItemsSource="{Binding RequestUpdates}" Visibility="{Binding RequestNews, Converter={views:ShownConverter}}">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.RequestNews, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Toad.Brush.Success}" />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                        <toad:Button HorizontalContentAlignment="Left" Padding="6,2" Margin="0,2,0,0"
                                     Command="{Binding DataContext.OpenRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Number, StringFormat=№ {0}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" />
                                <Run Text="{Binding CardName, StringFormat= → {0}, Mode=OneWay}" />
                            </TextBlock>
                        </toad:Button>
                            <WrapPanel Margin="6,2,0,2" Visibility="{Binding State, Converter={views:ShownConverter}, ConverterParameter=Review}">
                                <toad:Button Content="Подходит" Variant="Filled" Padding="8,1" Margin="0,0,6,0" CommandParameter="{Binding}"
                                             Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <toad:Button Content="Не то…" Padding="8,1" CommandParameter="{Binding}" ToolTip="Написать, что не так, — в браузере"
                                             Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Нет подключения, библиотека не настроена, ошибка -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top"
                    Visibility="{Binding Screen, Converter={views:ShownConverter Invert=True}, ConverterParameter=Ready}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Margin="0,8" />
            <toad:Button Content="Подключение…" Variant="Filled" Command="{Binding ConnectCommand}" HorizontalAlignment="Left"
                         Visibility="{Binding Screen, Converter={views:ShownConverter}, ConverterParameter=NotConnected}" />
        </StackPanel>

        <TabControl Grid.Row="1" Grid.RowSpan="2" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0"
                    Visibility="{Binding Screen, Converter={views:ShownConverter}, ConverterParameter=Ready}">

            <!-- Поиск и карточка -->
            <TabItem Header="Поиск">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <toad:TextBox Grid.Row="0" Placeholder="Имя, обозначение типоразмера, параметр…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <toad:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </toad:TextBox.InputBindings>
                    </toad:TextBox>
                    <Grid Grid.Row="1" Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox Grid.Column="0" ToolTip="Раздел" ItemsSource="{Binding SectionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Section}" />
                        <ComboBox Grid.Column="2" ToolTip="Категория" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Category}" />
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                            <toad:Button DockPanel.Dock="Right" Content="Нет нужного" Command="{Binding RequestFamilyCommand}"
                                         ToolTip="Подать заявку на семейство в вебе ToadFlow" />
                            <CheckBox Content="непроверенные" IsChecked="{Binding ShowUnreviewed}" VerticalAlignment="Center"
                                      ToolTip="Показывать и семейства, которые ещё на проверке" />
                            <TextBlock Text="{Binding Found}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="8,0" />
                        </DockPanel>
                    </Grid>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="4" Background="{DynamicResource Toad.Brush.Hover}" Margin="0,0,8,0">
                                        <Image Source="{Binding Preview, Converter={views:PreviewConverter DecodeWidth=112}}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding YearBadge}" FontSize="11" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource Toad.Brush.Warning}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="на проверке" FontSize="11" Foreground="{DynamicResource Toad.Brush.Warning}"
                                                   Visibility="{Binding Unreviewed, Converter={views:ShownConverter}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <toad:Button Grid.Row="3" Content="Показать ещё" Command="{Binding MoreCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                 Visibility="{Binding HasMore, Converter={views:ShownConverter}}" />
                </Grid>
            </TabItem>

            <!-- В проекте -->
            <TabItem Header="В проекте" IsEnabled="{Binding IsProject}">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ProjectSummary}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" Margin="0,0,0,6" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <toad:Button DockPanel.Dock="Right" Content="Обновить выбранные" Variant="Filled" Command="{Binding UpdateChosenCommand}" />
                        <CheckBox Content="только устаревшие и чужие" IsChecked="{Binding OnlyProblems}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding ProjectItems}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChosen}" IsEnabled="{Binding CanUpdate}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding StateText, Mode=OneWay}" /><Run Text=" · " Foreground="Gray" /><Run Text="{Binding Category, Mode=OneWay}" Foreground="Gray" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Публикация (координатор, в редакторе семейства) -->
            <TabItem Header="Опубликовать" Visibility="{Binding CanPublish, Converter={views:ShownConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Publish}">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding YearWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Toad.Brush.Warning}" Margin="0,0,0,6"
                                   Visibility="{Binding YearWarning, Converter={views:ShownConverter}}" />
                        <RadioButton Content="Новое семейство" IsChecked="{Binding IsNewVersion, Converter={views:NotConverter}}" Margin="0,0,0,4" />
                        <RadioButton Content="Новая версия существующего" IsChecked="{Binding IsNewVersion}" Margin="0,0,0,8" />

                        <StackPanel Visibility="{Binding IsNewVersion, Converter={views:ShownConverter Invert=True}}">
                            <TextBlock Text="Имя файла (имя семейства в проекте)" FontSize="11" Opacity="0.8" />
                            <toad:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="Папка от корня библиотеки — по умолчанию папка проверки" FontSize="11" Opacity="0.8" />
                            <toad:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsNewVersion, Converter={views:ShownConverter}}">
                            <TextBlock Text="Какое семейство обновляете — версия ляжет в папку проверки под его именем" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                            <toad:TextBox Placeholder="Имя семейства — Enter" Text="{Binding ExistingQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4">
                                <toad:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FindExistingCommand}" />
                                </toad:TextBox.InputBindings>
                            </toad:TextBox>
                            <ComboBox ItemsSource="{Binding ExistingResults}" SelectedItem="{Binding Existing}" DisplayMemberPath="Name" Margin="0,0,0,6" />
                        </StackPanel>

                        <TextBlock Text="Что изменилось" FontSize="11" Opacity="0.8" />
                        <toad:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,2,0,6" />
                        <TextBlock Text="Закрывает заявку" FontSize="11" Opacity="0.8" />
                        <ComboBox ItemsSource="{Binding Requests}" SelectedItem="{Binding Request}" DisplayMemberPath="Label" Margin="0,2,0,8" />
                        <toad:Button Content="Опубликовать" Variant="Filled" Command="{Binding PublishCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Карточка выбранного семейства -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Toad.Brush.Border}"
                Visibility="{Binding CardVisible, Converter={views:ShownConverter}}">
            <StackPanel DataContext="{Binding Card}">
                <DockPanel>
                    <toad:Button DockPanel.Dock="Right" Content="✕" Padding="6,0"
                                 Command="{Binding DataContext.CloseCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock Text="на проверке — показано, потому что включены «непроверенные»" FontSize="11" Foreground="{DynamicResource Toad.Brush.Warning}"
                           TextWrapping="Wrap" Visibility="{Binding Unreviewed, Converter={views:ShownConverter}}" />
                <DockPanel Margin="0,6">
                    <Border DockPanel.Dock="Left" Width="112" Height="112" CornerRadius="4" Background="{DynamicResource Toad.Brush.Hover}" Margin="0,0,8,0">
                        <Image Source="{Binding Preview, Converter={views:PreviewConverter DecodeWidth=224}}" Stretch="Uniform" />
                    </Border>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Типоразмеры" FontSize="11" Opacity="0.8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <toad:Button Content="все" Padding="4,0" Command="{Binding ChooseAllCommand}" />
                                <toad:Button Content="ни одного" Padding="4,0" Margin="4,0,0,0" Command="{Binding ChooseNoneCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Types}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChosen}" ToolTip="{Binding Details}" Margin="0,1">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding TypesNote}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Visibility="{Binding Description, Converter={views:ShownConverter}}" />
                <TextBlock FontSize="11" Opacity="0.8" TextWrapping="Wrap">
                    <Run Text="{Binding Updated, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Loads, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding BlockedReason}" Foreground="{DynamicResource Toad.Brush.Warning}" TextWrapping="Wrap"
                           Visibility="{Binding BlockedReason, Converter={views:ShownConverter}}" />
                <WrapPanel Margin="0,6,0,0">
                    <toad:Button Content="Загрузить" Variant="Filled" IsEnabled="{Binding CanLoad}" Margin="0,0,6,0"
                                 Command="{Binding DataContext.LoadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <toad:Button Content="Путь" Margin="0,0,6,0" ToolTip="{Binding FullPath}"
                                 Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <toad:Button Content="В вебе" Margin="0,0,6,0"
                                 Command="{Binding DataContext.OpenInWebCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <toad:Button Content="Сообщить о проблеме" ToolTip="Заявка «исправить семейство» — откроется в браузере"
                                 Command="{Binding DataContext.ReportProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </WrapPanel>
                <Expander Header="История" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Строка состояния: итог загрузки, отказ сервера -->
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                   Foreground="{DynamicResource Toad.Brush.Warning}" Visibility="{Binding Status, Converter={views:ShownConverter}}" />
    </Grid>
</UserControl>
