<toad:ToadWindow
    x:Class="CreateSpaces.Views.CreateSpacesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:conv="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    mc:Ignorable="d"
    Title="Создание пространств"
    WindowStartupLocation="CenterScreen"
    Height="500"
    Width="800"
    MinHeight="400"
    MinWidth="800"
    TitleIcon="CirclePlus">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title Bar -->
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Toad.Brush.Border}" CornerRadius="{DynamicResource Toad.Radius.Control}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="150">
                        <ListView
                            ItemsSource="{Binding LinkedModels, Mode=TwoWay}"
                            SelectedItem="{Binding SelectedLink, Mode=TwoWay}"
                            HorizontalContentAlignment="Stretch"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Border>
                <TextBlock Grid.Row="0" Text="Выберите связанный файл"
                           Background="{DynamicResource Toad.Brush.Surface}" 
                           Foreground="{DynamicResource Toad.Brush.Text}"
                           Padding="5,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="20,-10,0,0"/>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <RadioButton GroupName="Mode" Content="Создать пространства" IsChecked="{Binding CreateSpaces}" />
                    <RadioButton GroupName="Mode" Content="Перенести только значения параметров" Margin="0,6,0,0"
                                 IsChecked="{Binding CreateSpaces, Converter={conv:InverseBooleanConverter}}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Border Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Toad.Brush.Border}" CornerRadius="{DynamicResource Toad.Radius.Control}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <Grid Margin="10,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Параметр пространства" VerticalAlignment="Center" Margin="0"/>
                            
                            <TextBlock Grid.Column="1" Text="Параметр помещения" VerticalAlignment="Center" Margin="0"/>
                            
                        </Grid>
                        
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="150">
                        <ListView
                            ItemsSource="{Binding Models}"
                            HorizontalContentAlignment="Stretch"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="{Binding SpaceParameter.Name}" VerticalAlignment="Center" Margin="0"/>
                                        <ComboBox
                                            Grid.Column="1" ItemsSource="{Binding RoomParameters}" 
                                            DisplayMemberPath="Name"
                                            SelectedItem="{Binding SelectedRoomParameter, Mode=TwoWay}"
                                            Height="35"
                                            Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                    </Grid>
                </Border>
                <TextBlock Text="Сопоставление параметров"
                           Background="{DynamicResource Toad.Brush.Surface}" 
                           Foreground="{DynamicResource Toad.Brush.Text}"
                           Padding="5,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="20,-10,0,0"/>
            </Grid>
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10">
                <toad:Switch Content="Тёмная тема" VerticalAlignment="Center"
                    IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
                
                <toad:Button Content="Экспорт"
                           Icon="FileExport"
                           Command="{Binding ExportCommand}"
                           Margin="20,0,0,0" />
                
                <toad:Button Content="Импорт"
                           Icon="FileImport"
                           Command="{Binding ImportCommand}"
                           Margin="10,0,0,0" />
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,10">
                <toad:Button Content="Запуск"
                           Icon="Rocket"
                           Command="{Binding StartCommand}"
                           Variant="Filled"
                           Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</toad:ToadWindow>