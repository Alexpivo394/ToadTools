<ui:FluentWindow
    x:Class="ParamChecker.Views.ParametersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    xmlns:views="clr-namespace:ParamChecker.Views"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:ParametersEditorViewModel}"
    mc:Ignorable="d"
    Title="{Binding Title}"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Height="640"
    Width="620"
    MinHeight="420"
    MinWidth="520"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" Icon="TextBulletListLtr24" ShowMinimize="False" />

        <!-- Ввод имени с подсказками -->
        <Grid Grid.Row="1" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:AutoSuggestBox x:Name="NameInput" OriginalItemsSource="{Binding ParameterNames}"
                               Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Имя параметра — начните вводить, Enter добавляет" Icon="{x:Null}"
                               QuerySubmitted="OnQuerySubmitted" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Добавить" Icon="{ui:SymbolIcon Add24}" VerticalAlignment="Stretch"
                       Command="{Binding AddCommand}" />
        </Grid>

        <ui:Card Grid.Row="2" Margin="10,0,10,0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="8,6" AlternationCount="100000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ParameterItemViewModel}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Opacity="0.5" VerticalAlignment="Center"
                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={views:IndexConverter}}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <ui:SymbolIcon Symbol="Warning16" Margin="6,0,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       ToolTip="Такого имени нет в ФОП, в открытом проекте и среди системных параметров — проверьте, нет ли опечатки"
                                                       Visibility="{Binding IsKnown, Converter={uiConverters:InverseBooleanCollapsedVisibilityConverter}}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowUp20}" Appearance="Transparent" ToolTip="Выше"
                                               Command="{Binding MoveUpCommand}" />
                                    <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon ArrowDown20}" Appearance="Transparent" ToolTip="Ниже"
                                               Command="{Binding MoveDownCommand}" />
                                    <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Dismiss20}" Appearance="Transparent" ToolTip="Убрать"
                                               Command="{Binding RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Параметров нет. Впишите имя выше или скопируйте столбец имён из Excel и нажмите «Вставить список»."
                           Visibility="{Binding Parameters.Count, Converter={views:ZeroVisibleConverter}}" />
            </Grid>
        </ui:Card>

        <TextBlock Grid.Row="3" Margin="20,6,10,0" FontSize="12" TextWrapping="Wrap" Opacity="0.75"
                   Text="Подсказки — из ФОП, открытого проекта и системных параметров Revit. ⚠ — имени нет нигде из них (сверка работает, когда в Revit подключён ФОП). Параметр ищется у экземпляра, а если его там нет — у типа." />

        <Grid Grid.Row="4" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Вставить список" Icon="{ui:SymbolIcon ClipboardPaste24}"
                       ToolTip="Добавить имена из буфера обмена: по одному в строке, через табуляцию или «;»"
                       Command="{Binding PasteListCommand}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Очистить" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                       Command="{Binding ClearCommand}" />
            <ui:Button Grid.Column="3" Content="Отмена" Icon="{ui:SymbolIcon Dismiss24}" IsCancel="True" Click="OnCancel" />
            <ui:Button Grid.Column="4" Margin="8,0,0,0" Content="Применить" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary"
                       Click="OnApply" />
        </Grid>
    </Grid>
</ui:FluentWindow>
