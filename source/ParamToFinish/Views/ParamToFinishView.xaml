<toad:ToadWindow
    x:Class="ParamToFinish.Views.ParamToFinishView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:conv="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    xmlns:viewModels="clr-namespace:ParamToFinish.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ParamToFinishViewModel}"
    mc:Ignorable="d"
    Title="Основание отделки"
    WindowStartupLocation="CenterScreen"
    Height="500"
    Width="600"
    MinHeight="450"
    MinWidth="600"
    TitleIcon="CirclePlus">
<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title Bar -->
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock  Text="Параметр основной стены" FontWeight="Bold" Margin="10,0,0,10" />
            
            <ComboBox Grid.Row="1" ItemsSource="{Binding WallParameters, Mode=TwoWay}" 
                      SelectedItem="{Binding SelectedWallParameter, Mode=TwoWay}"/>
            
            <TextBlock Grid.Row="2" Text="Ключевое слово для фильтра отделки" FontWeight="Bold" Margin="10,10,0,10" />
            
            <toad:TextBox Grid.Row="3" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            
            <TextBlock Grid.Row="4" Text="Параметр отделки" FontWeight="Bold" Margin="10,10,0,10" />
            
            <ComboBox Grid.Row="5" ItemsSource="{Binding WallParameters, Mode=TwoWay}" 
                      SelectedItem="{Binding SelectedFinishParameter, Mode=TwoWay}"/>
            
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,10,0,10">
                <TextBlock Text="Вариант обработки модели:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton GroupName="Scope" Content="Активный вид" Margin="0,0,16,0"
                             IsChecked="{Binding AllModel, Converter={conv:InverseBooleanConverter}}" />
                <RadioButton GroupName="Scope" Content="Вся модель" IsChecked="{Binding AllModel}" />
            </StackPanel>
            
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <toad:Button Content="Запуск"
                           Icon="Rocket"
                           Command="{Binding StartCommand}"
                           Variant="Filled"
                           Margin="10,0,0,0" />
                    
            </StackPanel>
        </Grid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10">
            <toad:Switch Content="Тёмная тема"
                IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
        </StackPanel>
    </Grid>
</toad:ToadWindow>
