<UserControl
    x:Class="Collisions.Views.CollisionsPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Collisions.ViewModels"
    xmlns:views="clr-namespace:Collisions.Views"
    xmlns:conv="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=vm:PaneViewModel}"
    mc:Ignorable="d"
    d:DesignWidth="380" d:DesignHeight="700"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ToadTools.UI;component/Styles/App.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="GroupedItems" Source="{Binding Items}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: модель, части и дата прогона, «Обновить» -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter=Ready}">
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Parts}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Margin="8,0,0,0"
                       Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter='Ready,NoDocument,NotFound,Error,Choose'}" />
        </Grid>

        <!-- Сообщения: нет подключения, нет документа, модель не найдена, ошибка, поиск модели -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top"
                    Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter='NotConnected,NoDocument,NotFound,Error,Resolving'}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,8" />
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="{Binding Status, Converter={views:TextVisibilityConverter}}" />
            <TextBlock Text="{Binding SearchedPath, StringFormat=Искали: {0}}" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                       Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter=NotFound}" />
            <ui:Button Content="Подключение…" Appearance="Primary" Command="{Binding ConnectCommand}" Margin="0,8,0,0"
                       Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter=NotConnected}" />
            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left"
                             Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter=Resolving}" />
        </StackPanel>

        <!-- Несколько моделей с таким именем — выбор -->
        <DockPanel Grid.Row="1" Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter=Choose}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,8" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding Status, Converter={views:TextVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding Matches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,6"
                                   Command="{Binding DataContext.ChooseModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Discipline, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ModelPath}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Список коллизий -->
        <Grid Grid.Row="1" Visibility="{Binding Screen, Converter={views:ScreenVisibilityConverter}, ConverterParameter=Ready}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <!-- Место карточки: пока коллизия не выбрана, список занимает всю высоту -->
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="2*" />
                            <Setter Property="MinHeight" Value="120" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Card}" Value="{x:Null}">
                                    <Setter Property="Height" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox Grid.Row="0" Grid.Column="0" ToolTip="Статус" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}" />
                <ComboBox Grid.Row="0" Grid.Column="2" ToolTip="Кто правит" ItemsSource="{Binding GroupOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding GroupFilter}" />
                <ComboBox Grid.Row="2" Grid.Column="0" ToolTip="Пара разделов" ItemsSource="{Binding PairOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding PairFilter}" />
                <ComboBox Grid.Row="2" Grid.Column="2" ToolTip="Уровень" ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding LevelFilter}" />
                <ui:TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" PlaceholderText="№, ID элемента или UniqueId — Enter"
                            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </Grid>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <!-- Счётчики — переключатели, как в вебе: нажатие включает фильтр, повторное — снимает -->
                <ToggleButton Margin="0,0,6,4" Padding="6,1" FontSize="11" Content="{Binding MineCounter}" IsChecked="{Binding MineActive, Mode=OneWay}"
                              Command="{Binding MineFilterCommand}" ToolTip="Показать только мои и общие коллизии" />
                <ToggleButton Margin="0,0,6,4" Padding="6,1" FontSize="11" Content="{Binding OtherCounter}" IsChecked="{Binding OtherActive, Mode=OneWay}"
                              Command="{Binding OtherFilterCommand}" ToolTip="Показать коллизии, которые взяла другая сторона" />
                <!-- «новые для меня N» — фильтр since=unseen; у старого сервера счётчика нет, вместо него текст -->
                <ToggleButton Margin="0,0,6,4" Padding="6,1" FontSize="11" Content="{Binding NewForMe}" IsChecked="{Binding NewForMeActive, Mode=OneWay}"
                              Command="{Binding NewForMeFilterCommand}" ToolTip="Показать только коллизии, которые я ещё не открывал"
                              Visibility="{Binding NewForMe, Converter={views:TextVisibilityConverter}}" />
                <TextBlock Text="{Binding Counters}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding Counters, Converter={views:TextVisibilityConverter}}" />
            </WrapPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding Status, Converter={views:TextVisibilityConverter}}" />

            <ui:Button DockPanel.Dock="Bottom" Content="Показать ещё" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                       Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={conv:BooleanCollapsedVisibilityConverter}}" />

            <ListView x:Name="List" ItemsSource="{Binding Source={StaticResource GroupedItems}}" SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                      PreviewKeyDown="OnListKeyDown">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,8,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CollisionItemViewModel}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="72" CornerRadius="4" VerticalAlignment="Top"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <TextBlock Text="{Binding ThumbnailText}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" />
                                    <Image Source="{Binding Image, Converter={views:ThumbnailConverter}}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <!-- точка — новая для меня: я её ещё не открывал -->
                                    <Run Text="{Binding Dot, Mode=OneWay}" Foreground="{DynamicResource SystemAccentColorBrush}"
                                         ToolTip="Вы ещё не открывали эту коллизию — она появилась или вернулась после вашего последнего просмотра. Откройте карточку, и отметка снимется" />
                                    <Run Text="{Binding Number, StringFormat=№{0}, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Depth, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Pair, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Level, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Own}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Other}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Taken}" FontSize="11" FontStyle="Italic" Opacity="0.75"
                                           Visibility="{Binding Taken, Converter={views:TextVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"
                          Visibility="{Binding Card, Converter={views:NullVisibilityConverter}}" />
            <views:CollisionCardView Grid.Row="2" DataContext="{Binding Card}" Visibility="{Binding Converter={views:NullVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
