<Project>

    <!-- Общие настройки репозитория (CPM, Polyfill, JetBrains.Annotations). Проекты лежат вне source/, потому что
         source/Directory.Build.props подключает всем Revit API и Revit-конфигурации. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <!-- Версия программы ToadTools (трей) — версия релиза из тега: сборка передаёт VersionPrefix, как плагину.
         0.0.0 — только локальная сборка; Debug-сборка сама себя не обновляет. -->
    <PropertyGroup>
        <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.0.0</VersionPrefix>
        <TargetFramework>net48</TargetFramework>
        <Company>ToadTools</Company>
        <Product>ToadTools</Product>
    </PropertyGroup>

</Project>
