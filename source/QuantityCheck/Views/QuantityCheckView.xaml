<toad:ToadWindow
    x:Class="QuantityCheck.Views.QuantityCheckView"
    xmlns:toad="urn:toaddesign"
    xmlns:themes="clr-namespace:ToadTools.UI.Services;assembly=ToadTools.UI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="Записать количество"
    Height="300"
    Width="450"
    MinHeight="250"
    MinWidth="400"
    TitleIcon="CirclePlus">
    
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        
        <Grid Grid.Row="1" Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        
            <TextBlock  Text="Введите имя параметра для заполнения количества" FontWeight="SemiBold" Margin="0,0,0,6" />
            
            <toad:TextBox Grid.Row="1" Text="{Binding ParameterName, Mode=TwoWay}"
                        Placeholder="Имя параметра"/>
            
            <TextBlock Grid.Row="2" Text="Введите запас в процентах для длиновых элементов" FontWeight="SemiBold" Margin="0,14,0,6" />
            
            <toad:TextBox Grid.Row="3" Text="{Binding Reverse, Mode=TwoWay}"
                        Placeholder="Запас в процентах"/>
            
            
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <toad:Button Content="Запуск"
                           Icon="Rocket"
                           Command="{Binding WriteQuantityCommand}"
                           Variant="Filled"
                           Margin="10,0,0,0" />
                    
            </StackPanel>
        </Grid>
        

        <!-- Переключатель темы -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="20,0,0,18" Height="{DynamicResource Toad.Size.Control}">
            <toad:Switch Content="Тёмная тема" VerticalAlignment="Center"
                         IsChecked="{Binding IsDark, Source={x:Static themes:ThemePreference.Instance}}"/>
        </StackPanel>

    </Grid>
</toad:ToadWindow>