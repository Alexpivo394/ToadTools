<UserControl
    x:Class="ParamChecker.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    xmlns:views="clr-namespace:ParamChecker.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:ProfileViewModel}"
    mc:Ignorable="d">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>

        <!-- Имя профиля и умолчания для его моделей -->
        <ui:Card Grid.Row="0" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Имя профиля" Opacity="0.8" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например: ЖК Восход — ОВ"
                                FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Вид для всех моделей" Opacity="0.8" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="пусто — вся модель"
                                ToolTip="Элементы собираются с этого вида (обычно 3D-вид «Navisworks»). Пусто — со всей модели. У модели можно задать свой вид" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Не открывать РН со словом" Opacity="0.8" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding WorksetKeyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="пусто — открыть все РН"
                                ToolTip="Рабочие наборы, в имени которых есть это слово, при открытии останутся закрытыми — модель откроется быстрее. Связи RVT и так не загружаются (см. настройки)" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Модели -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Модели" FontWeight="Bold" />
                    <Run Text="{Binding Models.Count, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="С Revit Server" Icon="{ui:SymbolIcon Server24}" Appearance="Primary"
                               ToolTip="Выбрать модели в дереве Revit Server — сразу сколько угодно"
                               Command="{Binding AddFromServerCommand}" />
                    <ui:Button Content="Файлы" Icon="{ui:SymbolIcon FolderOpen24}" Margin="6,0,0,0"
                               ToolTip="Добавить модели .rvt с диска или из сетевой папки"
                               Command="{Binding AddFilesCommand}" />
                    <ui:Button Content="Путь" Icon="{ui:SymbolIcon TextEditStyle24}" Margin="6,0,0,0"
                               ToolTip="Добавить строку и вписать путь вручную"
                               Command="{Binding AddPathCommand}" />
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Margin="6,0,0,0" Appearance="Transparent"
                               ToolTip="Убрать все модели" Command="{Binding ClearModelsCommand}" />
                </StackPanel>
            </Grid>

            <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="12,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Модель и путь" Opacity="0.7" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="Свой вид" Opacity="0.7" FontSize="12" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="2" Text="Своё слово РН" Opacity="0.7" FontSize="12" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Models}" Margin="0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ModelItemViewModel}">
                                    <Grid Margin="12,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,8,0" FontSize="18" Opacity="0.8" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Document24" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsServer}" Value="True">
                                                            <Setter Property="Symbol" Value="Server24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,0,0,2" />
                                            <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     ToolTip="Путь к модели: RSN://сервер/папка/модель.rvt или путь к файлу. Можно поправить" />
                                        </StackPanel>
                                        <ui:TextBox Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{Binding ViewPlaceholder}" />
                                        <ui:TextBox Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Text="{Binding WorksetKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{Binding WorksetPlaceholder}" />
                                        <ui:Button Grid.Column="4" Margin="4,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                                   ToolTip="Убрать модель из профиля" Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextAlignment="Center"
                               Text="Моделей пока нет. Добавьте их с Revit Server, из папки или вписав путь."
                               Visibility="{Binding Models.Count, Converter={views:ZeroVisibleConverter}}" />
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Правила -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Правила" FontWeight="Bold" />
                    <Run Text="{Binding Rules.Count, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="  каждое правило — отдельный лист отчёта" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Добавить правило" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddRuleCommand}" />
                    <ui:Button Content="Вставить" Icon="{ui:SymbolIcon ClipboardPaste24}" Margin="6,0,0,0"
                               ToolTip="Вставить правило, скопированное командой «Копировать» (в том числе из другого профиля)"
                               Command="{Binding PasteRuleCommand}" />
                </StackPanel>
            </Grid>

            <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="12,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название (лист отчёта)" Opacity="0.7" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="Какие элементы проверять" Opacity="0.7" FontSize="12" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="2" Text="Какие параметры проверять" Opacity="0.7" FontSize="12" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rules}" Margin="0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:RuleViewModel}">
                                    <Grid Margin="12,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Например: Воздуховоды" VerticalAlignment="Center" />

                                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Stretch"
                                                   Command="{Binding EditFilterCommand}" ToolTip="{Binding FilterTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Filter24" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding FilterSummary}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FilterHasProblem}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Stretch"
                                                   Command="{Binding EditParametersCommand}" ToolTip="{Binding ParametersTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="TextBulletListLtr24" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding ParametersSummary}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ParametersHaveProblem}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="MoreButton" Grid.Column="3" Margin="4,0,0,0" Icon="{ui:SymbolIcon MoreVertical24}"
                                                   Appearance="Transparent" ToolTip="Ещё" Click="OnMoreClick">
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Дублировать" Icon="{ui:SymbolIcon CopyAdd24}" Command="{Binding DuplicateCommand}" />
                                                    <MenuItem Header="Копировать правило" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyCommand}"
                                                              ToolTip="В буфер обмена — чтобы вставить в другой профиль или взять из него фильтр или параметры" />
                                                    <Separator />
                                                    <MenuItem Header="Вставить фильтр" Icon="{ui:SymbolIcon ClipboardPaste24}" Command="{Binding PasteFilterCommand}"
                                                              ToolTip="Заменить фильтр этого правила фильтром скопированного" />
                                                    <MenuItem Header="Вставить параметры" Icon="{ui:SymbolIcon ClipboardPaste24}" Command="{Binding PasteParametersCommand}"
                                                              ToolTip="Заменить параметры этого правила параметрами скопированного" />
                                                    <Separator />
                                                    <MenuItem Header="Удалить" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}" />
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextAlignment="Center"
                               Text="Правил пока нет. Правило — какие элементы отобрать и какие параметры у них проверить."
                               Visibility="{Binding Rules.Count, Converter={views:ZeroVisibleConverter}}" />
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
