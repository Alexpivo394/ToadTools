<toad:ToadWindow
    x:Class="ModelTransplanter.Views.ModelTransplanterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:converters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    mc:Ignorable="d"
    Title="Копирование элементов"
    WindowStartupLocation="CenterScreen"
    Height="400"
    Width="400"
    MinHeight="350"
    MinWidth="350"
    TitleIcon="CirclePlus">

    <Grid>
        <!-- Title Bar -->

        <!-- Content -->
        <StackPanel Margin="20" VerticalAlignment="Center">

            <!-- Source Model -->
            <TextBlock Text="Исходная модель" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox 
                ItemsSource="{Binding OpenDocuments}" 
                DisplayMemberPath="Title"
                SelectedItem="{Binding SelectedSourceDoc}"
                Height="35"
                Margin="0,0,0,15"/>

            <!-- Target Model -->
            <TextBlock Text="Целевая модель" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox 
                ItemsSource="{Binding OpenDocuments}" 
                DisplayMemberPath="Title"
                SelectedItem="{Binding SelectedTargetDoc}"
                Height="35"
                Margin="0,0,0,15"/>

            <!-- Log File -->
            <TextBlock Text="Путь к лог-файлу" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox 
                    Text="{Binding LogFilePath, Mode=OneWay}" 
                    IsReadOnly="True"
                    Height="35"
                    VerticalContentAlignment="Center"
                    Margin="0,0,8,0"/>
                <toad:Button 
                    Content="..." 
                    Width="40" 
                    Height="35"
                    Command="{Binding SelectLogPathCommand}"
                    Grid.Column="1"/>
            </Grid>

            <!-- Start Transfer -->
            <toad:Button 
                Content="🚀 Начать перенос" 
                Height="40" 
                Command="{Binding TransferElementsCommand}" 
                IsEnabled="{Binding IsBusy, Converter={converters:InverseBoolConverter}}"
                Variant="Filled"
                Margin="0,0,0,15"/>

            <!-- Theme Toggle -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <toad:Switch Content="Тёмная тема"
                    IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</toad:ToadWindow>
