<UserControl
    x:Class="Families.Views.FamiliesPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:vm="clr-namespace:Families.ViewModels"
    xmlns:views="clr-namespace:Families.Views"
    xmlns:ui="clr-namespace:ToadTools.UI.Controls;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=vm:FamiliesPaneViewModel}"
    mc:Ignorable="d"
    d:DesignWidth="380" d:DesignHeight="760"
    Background="{DynamicResource Toad.Brush.Background}"
    Foreground="{DynamicResource Toad.Brush.Text}"
    FontSize="{DynamicResource Toad.FontSize.Small}"
    toad:Theme.IsRoot="True">

    <UserControl.Resources>
        <!-- Вкладки в теме ToadDesign: подпись и подсветка выбранной, без системной рамки -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="10,4" Margin="0,0,4,0" CornerRadius="4" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Toad.Brush.Hover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Список и карточка: высоты ставит разделитель — как пользователь перетащил или по умолчанию -->
            <RowDefinition MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: заявки с новостями, «Обновить», настройки -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <ui:SettingsButton DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Top" />
            <toad:Button DockPanel.Dock="Right" Icon="Refresh" Variant="Subtle" ToolTip="Обновить" Command="{Binding RefreshCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
            <toad:Loader DockPanel.Dock="Right" Width="18" Height="18" Visibility="{Binding IsBusy, Converter={views:ShownConverter}}" />
            <ItemsControl ItemsSource="{Binding RequestUpdates}" Visibility="{Binding RequestNews, Converter={views:ShownConverter}}">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.RequestNews, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Toad.Brush.Success}" />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                        <toad:Button HorizontalContentAlignment="Left" Padding="6,2" Margin="0,2,0,0"
                                     Command="{Binding DataContext.OpenRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Number, StringFormat=№ {0}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" />
                                <Run Text="{Binding CardName, StringFormat= → {0}, Mode=OneWay}" />
                            </TextBlock>
                        </toad:Button>
                            <WrapPanel Margin="6,2,0,2" Visibility="{Binding State, Converter={views:ShownConverter}, ConverterParameter=Review}">
                                <toad:Button Content="Подходит" Variant="Filled" Padding="8,1" Margin="0,0,6,0" CommandParameter="{Binding}"
                                             Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <toad:Button Content="Не то…" Padding="8,1" CommandParameter="{Binding}" ToolTip="Написать, что не так, — в браузере"
                                             Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Нет подключения, библиотека не настроена, ошибка -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top"
                    Visibility="{Binding Screen, Converter={views:ShownConverter Invert=True}, ConverterParameter=Ready}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource Toad.FontSize}" Margin="0,8" />
            <toad:Button Content="Настройки…" ToolTip="Войти в ToadFlow в настройках ToadTools" Variant="Filled" Command="{Binding ConnectCommand}" HorizontalAlignment="Left"
                         Visibility="{Binding Screen, Converter={views:ShownConverter}, ConverterParameter=NotConnected}" />
        </StackPanel>

        <TabControl Grid.Row="1" Grid.RowSpan="2" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0"
                    Visibility="{Binding Screen, Converter={views:ShownConverter}, ConverterParameter=Ready}">

            <!-- Поиск и карточка -->
            <TabItem Header="Поиск">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <toad:TextBox Grid.Row="0" Placeholder="Имя, обозначение типоразмера, параметр…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <toad:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </toad:TextBox.InputBindings>
                    </toad:TextBox>
                    <Grid Grid.Row="1" Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox Grid.Column="0" ToolTip="Раздел" ItemsSource="{Binding SectionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Section}" />
                        <ComboBox Grid.Column="2" ToolTip="Категория" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Category}" />
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                            <toad:Button DockPanel.Dock="Right" Content="Нет нужного" Command="{Binding RequestFamilyCommand}"
                                         ToolTip="Подать заявку на семейство в вебе ToadFlow" />
                            <CheckBox Content="непроверенные" IsChecked="{Binding ShowUnreviewed}" VerticalAlignment="Center"
                                      ToolTip="Показывать и семейства, которые ещё на проверке" />
                            <TextBlock Text="{Binding Found}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.7" VerticalAlignment="Center" Margin="8,0" />
                        </DockPanel>
                    </Grid>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="4" Background="{DynamicResource Toad.Brush.Hover}" Margin="0,0,8,0">
                                        <Image Source="{Binding Preview, Converter={views:PreviewConverter DecodeWidth=112}}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding YearBadge}" FontSize="{DynamicResource Toad.FontSize.Caption}" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource Toad.Brush.Warning}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Details}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="на проверке" FontSize="{DynamicResource Toad.FontSize.Caption}" Foreground="{DynamicResource Toad.Brush.Warning}"
                                                   Visibility="{Binding Unreviewed, Converter={views:ShownConverter}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <toad:Button Grid.Row="3" Content="Показать ещё" Command="{Binding MoreCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                 Visibility="{Binding HasMore, Converter={views:ShownConverter}}" />
                </Grid>
            </TabItem>

            <!-- В проекте -->
            <TabItem Header="В проекте" IsEnabled="{Binding IsProject}">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ProjectSummary}" TextWrapping="Wrap" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" Margin="0,0,0,6" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <toad:Button DockPanel.Dock="Right" Content="Обновить выбранные" Variant="Filled" Command="{Binding UpdateChosenCommand}" />
                        <CheckBox Content="только устаревшие и чужие" IsChecked="{Binding OnlyProblems}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding ProjectItems}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChosen}" IsEnabled="{Binding CanUpdate}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="{DynamicResource Toad.FontSize.Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding StateText, Mode=OneWay}" /><Run Text=" · " Foreground="Gray" /><Run Text="{Binding Category, Mode=OneWay}" Foreground="Gray" />
                                        </TextBlock>
                                        <TextBlock FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.75" TextTrimming="CharacterEllipsis" Visibility="{Binding Iteration, Converter={views:ShownConverter}}">
                                            <Run Text="итерация " /><Run Text="{Binding Iteration, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Публикация (координатор, в редакторе семейства) -->
            <TabItem Header="Опубликовать" Visibility="{Binding CanPublish, Converter={views:ShownConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Publish}">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding YearWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Toad.Brush.Warning}" Margin="0,0,0,6"
                                   Visibility="{Binding YearWarning, Converter={views:ShownConverter}}" />
                        <RadioButton GroupName="PublishMode" Content="Новое семейство" IsChecked="{Binding IsNewFamily}" Margin="0,0,0,4" />
                        <RadioButton GroupName="PublishMode" Content="Новая версия существующего (через проверку)" IsChecked="{Binding IsNewVersion}" Margin="0,0,0,4" />
                        <RadioButton GroupName="PublishMode" Content="В итерацию существующего (проектный вариант, сразу)" IsChecked="{Binding IsIteration}" Margin="0,0,0,8"
                                     Visibility="{Binding IterationsAvailable, Converter={views:ShownConverter}}" />

                        <StackPanel Visibility="{Binding IsNewFamily, Converter={views:ShownConverter}}">
                            <TextBlock Text="Имя файла (имя семейства в проекте)" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" />
                            <toad:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="Папка от корня библиотеки — по умолчанию папка проверки; можно вписать новую" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding Folders}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,2,0,6" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding NeedsExisting, Converter={views:ShownConverter}}">
                            <TextBlock Text="Какое семейство — новая версия «Основной» ляжет в папку проверки под его именем, итерация — в папку итераций" FontSize="{DynamicResource Toad.FontSize.Caption}"
                                       Opacity="0.8" TextWrapping="Wrap" />
                            <toad:TextBox Placeholder="Имя семейства — Enter" Text="{Binding ExistingQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4">
                                <toad:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FindExistingCommand}" />
                                </toad:TextBox.InputBindings>
                            </toad:TextBox>
                            <ComboBox ItemsSource="{Binding ExistingResults}" SelectedItem="{Binding Existing}" DisplayMemberPath="Name" Margin="0,0,0,6" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsIteration, Converter={views:ShownConverter}}">
                            <TextBlock Text="Итерация (завершённые не показаны — с них снимают финал в вебе)" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding Iterations}" SelectedItem="{Binding Iteration}" DisplayMemberPath="Label" Margin="0,2,0,6" />
                            <StackPanel Visibility="{Binding IsNewIteration, Converter={views:ShownConverter}}">
                                <TextBlock Text="Название новой итерации — имя её папки, например «ЖК Полковая»" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" TextWrapping="Wrap" />
                                <toad:TextBox Text="{Binding NewIterationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
                                <TextBlock Text="Комментарий к итерации" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" />
                                <toad:TextBox Text="{Binding IterationComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2,0,6" />
                            </StackPanel>
                            <CheckBox Content="Финальная версия итерации — итерация завершается" IsChecked="{Binding IsFinal}" Margin="0,0,0,4" />
                            <StackPanel Visibility="{Binding IsFinal, Converter={views:ShownConverter}}">
                                <TextBlock Text="Что проделано (обязательно)" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" />
                                <toad:TextBox Text="{Binding FinalComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2,0,6" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Что изменилось" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" />
                        <toad:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,2,0,6" />
                        <StackPanel Visibility="{Binding IsIteration, Converter={views:ShownConverter Invert=True}}">
                            <TextBlock Text="Закрывает заявку" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" />
                            <ComboBox ItemsSource="{Binding Requests}" SelectedItem="{Binding Request}" DisplayMemberPath="Label" Margin="0,2,0,6" />
                        </StackPanel>
                        <CheckBox Content="Без оповещения — мелкая правка, тем, кто загружал, «Обновлено» не придёт" IsChecked="{Binding Silent}" Margin="0,0,0,8" />
                        <toad:Button Content="Опубликовать" Variant="Filled" Command="{Binding PublishCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <ui:PaneSplitter Grid.Row="3" Key="Families" IsOpen="{Binding CardVisible}" DefaultShare="0.45" CompactShare="0.45" BottomMinHeight="120" />

        <!-- Карточка выбранного семейства; длинная прокручивается -->
        <Border Grid.Row="4" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Toad.Brush.Border}"
                Visibility="{Binding CardVisible, Converter={views:ShownConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel DataContext="{Binding Card}">
                <DockPanel>
                    <toad:Button DockPanel.Dock="Right" Icon="X" Variant="Subtle" ToolTip="Закрыть карточку"
                                 Command="{Binding DataContext.CloseCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource Toad.FontSize}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock Text="на проверке — показано, потому что включены «непроверенные»" FontSize="{DynamicResource Toad.FontSize.Caption}" Foreground="{DynamicResource Toad.Brush.Warning}"
                           TextWrapping="Wrap" Visibility="{Binding Unreviewed, Converter={views:ShownConverter}}" />
                <StackPanel Visibility="{Binding HasIterations, Converter={views:ShownConverter}}" Margin="0,6,0,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="завершённые" IsChecked="{Binding ShowFinished}" VerticalAlignment="Center"
                                  Visibility="{Binding HasFinished, Converter={views:ShownConverter}}" />
                        <TextBlock Text="Вариант" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" VerticalAlignment="Center" />
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="Label" Margin="0,2,0,2" />
                    <TextBlock Text="{Binding VariantNote}" FontSize="{DynamicResource Toad.FontSize.Caption}" TextWrapping="Wrap" Opacity="0.85" Visibility="{Binding VariantNote, Converter={views:ShownConverter}}" />
                </StackPanel>
                <DockPanel Margin="0,6">
                    <Border DockPanel.Dock="Left" Width="112" Height="112" CornerRadius="4" Background="{DynamicResource Toad.Brush.Hover}" Margin="0,0,8,0">
                        <Image Source="{Binding Preview, Converter={views:PreviewConverter DecodeWidth=224}}" Stretch="Uniform" />
                    </Border>
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <toad:Button Content="все" Padding="4,0" Command="{Binding ChooseAllCommand}" />
                                <toad:Button Content="ни одного" Padding="4,0" Margin="4,0,0,0" Command="{Binding ChooseNoneCommand}" />
                            </StackPanel>
                            <TextBlock Text="Типоразмеры" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Types}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChosen}" ToolTip="{Binding Details}" Margin="0,1">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding TypesNote}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Visibility="{Binding Description, Converter={views:ShownConverter}}" />
                <TextBlock FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.8" TextWrapping="Wrap">
                    <Run Text="{Binding Updated, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Loads, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding BlockedReason}" Foreground="{DynamicResource Toad.Brush.Warning}" TextWrapping="Wrap"
                           Visibility="{Binding BlockedReason, Converter={views:ShownConverter}}" />
                <!-- «Загрузить» — с подписью; остальное значками, смысл в подсказке -->
                <WrapPanel Margin="0,6,0,0">
                    <toad:Button Icon="Download" Content="Загрузить" Variant="Filled" IsEnabled="{Binding CanLoad}" Margin="0,0,4,4"
                                 Command="{Binding DataContext.LoadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <toad:Button Icon="Folder" Margin="0,0,4,4"
                                 Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <toad:Button.ToolTip>
                            <TextBlock Text="{Binding FullPath, StringFormat=Показать в папке: {0}}" />
                        </toad:Button.ToolTip>
                    </toad:Button>
                    <toad:Button Icon="World" ToolTip="Открыть в вебе ToadFlow" Margin="0,0,4,4"
                                 Command="{Binding DataContext.OpenInWebCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <toad:Button Icon="Flag" ToolTip="Сообщить о проблеме — заявка «исправить семейство» откроется в браузере" Margin="0,0,4,4"
                                 Command="{Binding DataContext.ReportProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </WrapPanel>
                <Expander Header="История" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{DynamicResource Toad.FontSize.Caption}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Строка состояния: итог загрузки, отказ сервера -->
        <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap" FontSize="{DynamicResource Toad.FontSize.Caption}" Margin="0,4,0,0"
                   Foreground="{DynamicResource Toad.Brush.Warning}" Visibility="{Binding Status, Converter={views:ShownConverter}}" />
    </Grid>
</UserControl>
