<UserControl
    x:Class="Collisions.Views.CollisionCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:vm="clr-namespace:Collisions.ViewModels"
    xmlns:views="clr-namespace:Collisions.Views"
    xmlns:conv="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    xmlns:services="clr-namespace:ToadTools.UI.Services;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=vm:CardViewModel}"
    mc:Ignorable="d"
    d:DesignWidth="380">

    <UserControl.Resources>
        <DataTemplate x:Key="ParameterTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource Toad.FontSize.Caption}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,4,4">
            <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource Toad.FontSize}" TextWrapping="Wrap">
                <Run Text="{Binding Number, StringFormat=№ {0}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{Binding Depth, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Assignee, StringFormat=Кто правит: {0}}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.75" />

            <TextBlock Text="{Binding NavigateMessage}" TextWrapping="Wrap" FontSize="{DynamicResource Toad.FontSize.Small}" Margin="0,6,0,0"
                       Foreground="{DynamicResource Toad.Brush.Warning}"
                       Visibility="{Binding NavigateMessage, Converter={views:TextVisibilityConverter}}" />
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="{DynamicResource Toad.FontSize.Small}" Margin="0,6,0,0"
                       Foreground="{DynamicResource Toad.Brush.Danger}"
                       Visibility="{Binding Error, Converter={views:TextVisibilityConverter}}" />

            <!-- Действия: те же, что в веб-карточке. Подписи короткие, редкие действия — только значком; полный смысл в подсказке -->
            <WrapPanel Margin="0,8,0,0">
                <toad:Button Icon="HandStop" Content="Беру" ToolTip="Беру — правлю я" Command="{Binding TakeCommand}" Margin="0,0,4,4"
                           Visibility="{Binding CanTake, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <toad:Button Icon="ArrowForwardUp" Content="Передать…" ToolTip="Передать другой стороне" Command="{Binding PassCommand}" Margin="0,0,4,4"
                           Visibility="{Binding CanPass, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <toad:Button Icon="Check" Content="Исправлена" Command="{Binding FixedCommand}" Margin="0,0,4,4"
                           ToolTip="{x:Static vm:CardViewModel.FixedHint}"
                           Visibility="{Binding CanFixed, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <toad:Button Icon="Ghost" Content="Фиктивная…" ToolTip="Пометить коллизию фиктивной — с причиной" Command="{Binding FakeCommand}" Margin="0,0,4,4"
                           Visibility="{Binding CanFake, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <toad:Button Icon="GhostOff" Content="Не фиктивная" ToolTip="Снять отметку «фиктивная»" Command="{Binding UnfakeCommand}" Margin="0,0,4,4"
                           Visibility="{Binding CanUnfake, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <toad:Button Icon="Note" ToolTip="Примечание…" Command="{Binding NoteCommand}" Margin="0,0,4,4"
                           Visibility="{Binding CanNote, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                <toad:Button Icon="Cube" ToolTip="Показать в ToadFlow — 3D коллизии в браузере" Command="{Binding OpenIn3DCommand}" Margin="0,0,4,4" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Выделить:" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,4" />
                <toad:Button Icon="Pointer" Content="Свой" ToolTip="Выделить в Revit только свой элемент" Command="{Binding SelectOwnCommand}" Margin="0,0,4,4" />
                <toad:Button Icon="Pointer" Content="Второй" ToolTip="Выделить в Revit только второй элемент" Command="{Binding SelectOtherCommand}" Margin="0,0,4,4" />
            </WrapPanel>
            <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.7" TextWrapping="Wrap"
                       Visibility="{Binding Hint, Converter={views:TextVisibilityConverter}}" />

            <Border CornerRadius="4" Margin="0,8,0,0" MinHeight="120" Background="{DynamicResource Toad.Brush.Hover}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                        <TextBlock Text="{Binding ImageText}" FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
                        <toad:Button Content="Обновить" Command="{Binding RefreshImageCommand}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="{Binding CanRefreshImage, Converter={conv:BooleanCollapsedVisibilityConverter}}" />
                    </StackPanel>
                    <!-- Картинка до 320 px; в компактном размере до 200 — карточке хватает места на кнопки и параметры -->
                    <Image Source="{Binding Image}" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="MaxHeight" Value="320" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, Source={x:Static services:ThemePreference.Instance}}" Value="True">
                                        <Setter Property="MaxHeight" Value="200" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
            </Border>

            <TextBlock Text="Свой элемент" FontWeight="SemiBold" Margin="0,10,0,2" />
            <ItemsControl ItemsSource="{Binding OwnParameters}" ItemTemplate="{StaticResource ParameterTemplate}" />

            <TextBlock Text="Второй элемент" FontWeight="SemiBold" Margin="0,10,0,2" />
            <ItemsControl ItemsSource="{Binding OtherParameters}" ItemTemplate="{StaticResource ParameterTemplate}" />

            <TextBlock Text="Лента" FontWeight="SemiBold" Margin="0,10,0,2" />
            <ItemsControl ItemsSource="{Binding Feed}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource Toad.FontSize.Caption}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
