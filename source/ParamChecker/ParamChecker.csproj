<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <ItemGroup>
        <PackageReference Include="Alexpivo394.Revit.ParamCheck"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf"/>
        <PackageReference Include="Newtonsoft.Json"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
        <PackageReference Include="WPF-UI"/>
        <PackageReference Include="WPF-UI.Abstractions"/>
    </ItemGroup>

    <!-- net48 facade assemblies; on .NET they ship with the runtime -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETFramework'">
        <PackageReference Include="System.Buffers"/>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe"/>
        <!-- HttpClient для отправки итогов в ToadFlow; на .NET входит в рантайм -->
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ToadTools.UI\ToadTools.UI.csproj"/>
    </ItemGroup>

</Project>
