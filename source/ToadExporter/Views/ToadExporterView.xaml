<ui:FluentWindow
    x:Class="ToadExporter.Views.ToadExporterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ToadExporter.ViewModels"
    xmlns:tree="clr-namespace:ToadExporter.ViewModels.Tree"
    xmlns:views="clr-namespace:ToadExporter.Views"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:ToadExporterViewModel}"
    mc:Ignorable="d"
    Title="ToadExporter"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Height="800"
    Width="1100"
    MinHeight="620"
    MinWidth="900"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Строка дерева на всю ширину: отступ уровня — внутри строки, поэтому колонки RVT/NWC ровные -->
        <Style x:Key="ModelTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="0,1"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ToadExporter" Icon="ArrowExportUp24" />

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:InfoBar Grid.Row="0"
                        Margin="0,0,0,10"
                        Severity="Warning"
                        IsClosable="False"
                        Title="Navisworks Exporter не установлен"
                        Message="Доступна только выгрузка в RVT — колонка NWC и настройки NWC неактивны."
                        IsOpen="{Binding NwcAvailable, Converter={uiConverters:InverseBooleanConverter}, Mode=OneWay}" />

            <!-- Источник -->
            <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Источник" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <ui:Button Content="Revit Server" Icon="{ui:SymbolIcon Server24}"
                                   Appearance="{Binding IsServerMode, Converter={views:SelectedAppearanceConverter}}"
                                   Command="{Binding SelectServerCommand}" />
                        <ui:Button Content="Папка" Icon="{ui:SymbolIcon Folder24}" Margin="4,0,0,0"
                                   Appearance="{Binding IsFolderMode, Converter={views:SelectedAppearanceConverter}}"
                                   Command="{Binding SelectFolderCommand}" />
                    </StackPanel>

                    <Grid Grid.Column="2"
                          Visibility="{Binding IsServerMode, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" IsEditable="True"
                                  ItemsSource="{Binding Servers}"
                                  Text="{Binding Settings.Server, UpdateSourceTrigger=LostFocus}"
                                  ToolTip="Серверы из RSN.ini; имя можно вписать вручную" />
                        <TextBlock Grid.Column="1" Text="{Binding ServerVersionText}" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="10,0" />
                        <ui:Button Grid.Column="2" Content="Обновить" Icon="{ui:SymbolIcon ArrowSync24}" VerticalAlignment="Stretch"
                                   Command="{Binding ReloadCommand}" />
                    </Grid>

                    <Grid Grid.Column="2"
                          Visibility="{Binding IsFolderMode, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Папка с моделями"
                                    Text="{Binding Settings.SourceFolder, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button Grid.Column="1" Content="Обзор" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                   Command="{Binding BrowseSourceCommand}" />
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                   ToolTip="Обновить" Command="{Binding ReloadCommand}" />
                    </Grid>
                </Grid>
            </ui:Card>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- Модели -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Модели" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Все RVT" Appearance="Transparent" Command="{Binding SelectAllRvtCommand}" />
                            <ui:Button Content="Все NWC" Appearance="Transparent" Command="{Binding SelectAllNwcCommand}"
                                       IsEnabled="{Binding NwcAvailable}" />
                            <ui:Button Content="Снять все" Appearance="Transparent" Command="{Binding ClearAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ui:TextBox Grid.Row="0" Margin="8" PlaceholderText="Поиск по имени модели"
                                        Icon="{ui:SymbolIcon Search24}"
                                        Text="{Binding Tree.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:InfoBar Grid.Row="1" Margin="8,0,8,8" Severity="Error" IsClosable="False"
                                        Title="Не удалось загрузить"
                                        Message="{Binding Tree.Error}"
                                        IsOpen="{Binding Tree.HasError, Mode=OneWay}" />

                            <Border Grid.Row="2" BorderThickness="0,1,0,1" Padding="12,4"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Папка / модель" Opacity="0.7" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="RVT" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="NWC" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TreeView x:Name="ModelTree" Grid.Row="3" Margin="4,2,0,4" Padding="0"
                                      Background="Transparent" BorderThickness="0"
                                      ItemsSource="{Binding Tree.Roots}"
                                      ItemContainerStyle="{StaticResource ModelTreeItem}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type tree:TreeNodeViewModel}"
                                                              ItemsSource="{Binding Children}"
                                                              ItemContainerStyle="{StaticResource ModelTreeItem}">
                                        <Grid Margin="8,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Margin="{Binding Depth, Converter={views:DepthIndentConverter}}">
                                                <ToggleButton Width="22" Height="22" Padding="0" MinWidth="0"
                                                              Background="Transparent" BorderThickness="0"
                                                              IsChecked="{Binding IsExpanded}"
                                                              Visibility="{Binding IsFolder, Converter={uiConverters:BooleanHiddenVisibilityConverter}}">
                                                    <ui:SymbolIcon FontSize="12">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="ChevronRight20" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Symbol" Value="ChevronDown20" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </ToggleButton>
                                                <ui:SymbolIcon Margin="2,0,6,0" FontSize="16" Opacity="0.8">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Cube20" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Symbol" Value="Folder20" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                    <Setter Property="Symbol" Value="ArrowSync20" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Center"
                                                      IsThreeState="False"
                                                      IsChecked="{Binding Rvt}"
                                                      Visibility="{Binding IsPlaceholder, Converter={uiConverters:InverseBooleanHiddenVisibilityConverter}}" />
                                            <CheckBox Grid.Column="2" MinWidth="0" HorizontalAlignment="Center"
                                                      IsThreeState="False"
                                                      IsChecked="{Binding Nwc}"
                                                      IsEnabled="{Binding DataContext.NwcAvailable, ElementName=ModelTree}"
                                                      Visibility="{Binding IsPlaceholder, Converter={uiConverters:InverseBooleanHiddenVisibilityConverter}}" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasModels, Converter={uiConverters:InverseBooleanCollapsedVisibilityConverter}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,8"
                                                 Visibility="{Binding Tree.IsLoading, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                                <TextBlock Text="{Binding EmptyText}" Opacity="0.7" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <TextBlock Grid.Row="2" Margin="10,6,0,0" Opacity="0.7" FontSize="12" Text="{Binding SelectionText}" />
                </Grid>

                <!-- Настройки -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Выгрузка" FontWeight="Bold" Margin="10,0,0,5" />
                        <ui:Card Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Папка для результатов (RVT и NWC вместе)" Opacity="0.8" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding Settings.OutputFolder, UpdateSourceTrigger=LostFocus}" />
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                               ToolTip="Обзор" Command="{Binding BrowseOutputCommand}"/>
                                </Grid>
                                <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                                           Text="Имя как у оригинала, существующие файлы перезаписываются" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Открытие" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <CheckBox Content="Не загружать связи" IsChecked="{Binding Settings.SkipLinks}" />
                                <TextBlock Margin="28,0,0,4" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                                           Text="Модель копируется во временную папку, связи в копии помечаются «не загружать». Исходник не меняется. Неудалённые связи сохраняются в RVT выгруженными, в NWC их нет." />
                                <CheckBox Content="Проверка" IsChecked="{Binding Settings.Audit}"
                                          ToolTip="Revit проверит и исправит модель при открытии — заметно дольше" />
                                <TextBlock Text="Не открывать рабочие наборы, содержащие" Opacity="0.8" Margin="0,8,0,4" />
                                <ui:TextBox PlaceholderText="Например: Связь"
                                            Text="{Binding Settings.WorksetKeyword, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:CardExpander Header="RVT — обработка перед сохранением" Icon="{ui:SymbolIcon Save24}"
                                         Margin="0,0,0,8" IsExpanded="{Binding Settings.RvtExpanded}">
                            <StackPanel>
                                <CheckBox Content="Удалить связи RVT (и IFC)" IsChecked="{Binding Settings.DeleteRevitLinks}" />
                                <CheckBox Content="Удалить импорт и связи CAD" IsChecked="{Binding Settings.DeleteCad}" Margin="0,4,0,0" />
                                <CheckBox Content="Удалить облака точек" IsChecked="{Binding Settings.DeletePointClouds}" Margin="0,4,0,0" />
                                <CheckBox Content="Очистить неиспользуемое" IsChecked="{Binding Settings.Purge}" Margin="0,4,0,0"
                                          IsEnabled="{Binding PurgeAvailable}" ToolTip="{Binding PurgeHint}"
                                          ToolTipService.ShowOnDisabled="True" />
                                <CheckBox Content="Сжать файл" IsChecked="{Binding Settings.Compact}" Margin="0,4,0,0" />
                                <TextBlock Margin="0,8,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                                           Text="Модель совместной работы сохраняется локальной копией с рабочими наборами (как createLocalRVT); её файл хранилища не сохраняется" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="NWC — основное" Icon="{ui:SymbolIcon Cube24}" Margin="0,0,0,8"
                                         IsEnabled="{Binding NwcAvailable}" IsExpanded="{Binding Settings.NwcMainExpanded}">
                            <StackPanel>
                                <TextBlock Text="Имя 3D-вида для экспорта" Opacity="0.8" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding Settings.NwcViewName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Координаты" Opacity="0.8" Margin="0,8,0,4" />
                                <ComboBox ItemsSource="{Binding CoordinateOptions}" DisplayMemberPath="Title"
                                          SelectedValuePath="Value" SelectedValue="{Binding Settings.NwcSharedCoordinates}" />
                                <TextBlock Text="Параметры" Opacity="0.8" Margin="0,8,0,4" />
                                <ComboBox ItemsSource="{Binding ParameterOptions}" DisplayMemberPath="Title"
                                          SelectedValuePath="Value" SelectedValue="{Binding Settings.NwcParameters}" />
                                <CheckBox Content="Преобразовать свойства элементов" Margin="0,8,0,0"
                                          IsChecked="{Binding Settings.NwcConvertElementProperties}" />
                                <CheckBox Content="Разделить файл по уровням" Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.NwcDivideIntoLevels}" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="NWC — что экспортировать" Icon="{ui:SymbolIcon Cube24}" Margin="0,0,0,8"
                                         IsEnabled="{Binding NwcAvailable}" IsExpanded="{Binding Settings.NwcContentExpanded}">
                            <StackPanel>
                                <CheckBox Content="Связанные модели Revit" IsChecked="{Binding Settings.NwcExportLinks}" />
                                <CheckBox Content="Связанные файлы CAD" IsChecked="{Binding Settings.NwcConvertLinkedCad}" Margin="0,4,0,0" />
                                <CheckBox Content="Части" IsChecked="{Binding Settings.NwcExportParts}" Margin="0,4,0,0" />
                                <CheckBox Content="Геометрия помещений" IsChecked="{Binding Settings.NwcRoomGeometry}" Margin="0,4,0,0" />
                                <CheckBox Content="Помещения как атрибут" IsChecked="{Binding Settings.NwcRoomAsAttribute}" Margin="0,4,0,0" />
                                <CheckBox Content="Источники света" IsChecked="{Binding Settings.NwcConvertLights}" Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="NWC — дополнительно" Icon="{ui:SymbolIcon Options24}" Margin="0,0,0,8"
                                         IsEnabled="{Binding NwcAvailable}" IsExpanded="{Binding Settings.NwcExtraExpanded}">
                            <StackPanel>
                                <CheckBox Content="ID элементов" IsChecked="{Binding Settings.NwcExportElementIds}" />
                                <CheckBox Content="URL" IsChecked="{Binding Settings.NwcExportUrls}" Margin="0,4,0,0" />
                                <CheckBox Content="Искать отсутствующие материалы" IsChecked="{Binding Settings.NwcFindMissingMaterials}" Margin="0,4,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Коэффициент фасетизации" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" Width="80" ClearButtonEnabled="False"
                                                Text="{Binding Settings.NwcFacetingFactor, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Подвал -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Тема:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ui:ToggleSwitch IsChecked="{Binding Settings.DarkTheme, Mode=TwoWay}"
                                 OffContent="Светлая"
                                 OnContent="Темная" />
                <TextBlock Text="Конфигурация:" VerticalAlignment="Center" Margin="20,0,10,0" />
                <ui:Button Content="Загрузить"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTip="Загружает настройки и отмеченные модели из файла .json"
                           Command="{Binding ImportConfigCommand}" />
                <ui:Button Margin="8,0,0,0"
                           Content="Сохранить"
                           Icon="{ui:SymbolIcon Save24}"
                           ToolTip="Сохраняет настройки и отмеченные модели в файл .json"
                           Command="{Binding ExportConfigCommand}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Margin="0,0,8,0"
                       Content="Открыть последний журнал"
                       Icon="{ui:SymbolIcon DocumentText24}"
                       IsEnabled="{Binding HasLastLog}"
                       Command="{Binding OpenLastLogCommand}" />
            <ui:Button Grid.Column="2"
                       Content="{Binding ExportText}"
                       Icon="{ui:SymbolIcon ArrowExportUp24}"
                       Command="{Binding ExportCommand}"
                       Appearance="Primary" />
        </Grid>
    </Grid>
</ui:FluentWindow>
