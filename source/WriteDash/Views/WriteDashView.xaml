<toad:ToadWindow
    x:Class="WriteDash.Views.WriteDashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    mc:Ignorable="d"
    Title="Записать прочерк"
    WindowStartupLocation="CenterScreen"
    Height="500"
    Width="600"
    MinHeight="450"
    MinWidth="600"
    TitleIcon="CirclePlus">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title Bar -->
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock  Text="Параметры для заполнения" FontWeight="Bold" Margin="10,0,0,10" />
            <toad:TextBox Grid.Row="1" Text="{Binding ParametersFilter, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Поиск параметров..."
                        Margin="10,0,10,10" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredParameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Имя текстом, а не Content-строкой: иначе «_» в ADSK_… съедается как клавиша доступа. -->
                            <CheckBox IsChecked="{Binding IsSelected}">
                                <TextBlock Text="{Binding Name}" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <toad:Button Content="Запуск"
                           Icon="Rocket"
                           Command="{Binding StartCommand}"
                           Variant="Filled"
                           Margin="10,0,0,0" />
                    
            </StackPanel>
        </Grid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10">
            <toad:Switch Content="Тёмная тема"
                IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
        </StackPanel>
    </Grid>
</toad:ToadWindow>