<Project Sdk="Microsoft.NET.Sdk">

    <!-- Логика программы ToadTools без интерфейса: релизы GitHub, подпись, скачивание, подмена плагина, ожидание Revit -->
    <PropertyGroup>
        <RootNamespace>ToadTools.Desktop.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="System.Net.Http"/>
        <Reference Include="System.IO.Compression"/>
        <Reference Include="System.IO.Compression.FileSystem"/>
        <Using Include="System.Net.Http"/>
    </ItemGroup>

</Project>
