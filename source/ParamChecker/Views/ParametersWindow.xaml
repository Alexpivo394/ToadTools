<toad:ToadWindow
    x:Class="ParamChecker.Views.ParametersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    xmlns:views="clr-namespace:ParamChecker.Views"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:ParametersEditorViewModel}"
    mc:Ignorable="d"
    Title="{Binding Title}"
    WindowStartupLocation="CenterOwner"
    Height="640"
    Width="620"
    MinHeight="420"
    MinWidth="520"
    ShowInTaskbar="False"
    ShowMinimizeButton="False"
    TitleIcon="List">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Ввод имени с подсказками -->
        <Grid Grid.Row="1" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <toad:AutoSuggestBox x:Name="NameInput" ItemsSource="{Binding ParameterNames}"
                               Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Placeholder="Имя параметра — начните вводить, Enter добавляет"                                KeyDown="OnInputKeyDown" SuggestionChosen="OnSuggestionChosen" />
            <toad:Button Grid.Column="1" Margin="8,0,0,0" Content="Добавить" Icon="Plus" VerticalAlignment="Stretch"
                       Command="{Binding AddCommand}" />
        </Grid>

        <toad:Card Grid.Row="2" Margin="10,0,10,0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="8,6" AlternationCount="100000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ParameterItemViewModel}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Opacity="0.5" VerticalAlignment="Center"
                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={views:IndexConverter}}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <toad:Icon Symbol="AlertTriangle" Margin="6,0,0,0" Foreground="{DynamicResource Toad.Brush.Warning}"
                                                       ToolTip="Такого имени нет в ФОП, в открытом проекте и среди системных параметров — проверьте, нет ли опечатки"
                                                       Visibility="{Binding IsKnown, Converter={uiConverters:InverseBooleanCollapsedVisibilityConverter}}" />
                                    </StackPanel>
                                    <toad:Button Grid.Column="2" Icon="ArrowUp" ToolTip="Выше"
                                               Command="{Binding MoveUpCommand}" />
                                    <toad:Button Grid.Column="3" Icon="ArrowDown" ToolTip="Ниже"
                                               Command="{Binding MoveDownCommand}" />
                                    <toad:Button Grid.Column="4" Icon="X" ToolTip="Убрать"
                                               Command="{Binding RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Параметров нет. Впишите имя выше или скопируйте столбец имён из Excel и нажмите «Вставить список»."
                           Visibility="{Binding Parameters.Count, Converter={views:ZeroVisibleConverter}}" />
            </Grid>
        </toad:Card>

        <TextBlock Grid.Row="3" Margin="20,6,10,0" FontSize="12" TextWrapping="Wrap" Opacity="0.75"
                   Text="Подсказки — из ФОП, открытого проекта и системных параметров Revit. ⚠ — имени нет нигде из них (сверка работает, когда в Revit подключён ФОП). Параметр ищется у экземпляра, а если его там нет — у типа." />

        <Grid Grid.Row="4" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <toad:Button Grid.Column="0" Content="Вставить список" Icon="Clipboard"
                       ToolTip="Добавить имена из буфера обмена: по одному в строке, через табуляцию или «;»"
                       Command="{Binding PasteListCommand}" />
            <toad:Button Grid.Column="1" Margin="8,0,0,0" Content="Очистить" Icon="Trash" Variant="Subtle"
                       Command="{Binding ClearCommand}" />
            <toad:Button Grid.Column="3" Content="Отмена" Icon="X" IsCancel="True" Click="OnCancel" />
            <toad:Button Grid.Column="4" Margin="8,0,0,0" Content="Применить" Icon="Check" Variant="Filled"
                       Click="OnApply" />
        </Grid>
    </Grid>
</toad:ToadWindow>
