<Project Sdk="Nice3point.Revit.Sdk/6.3.2">

  <PropertyGroup>
    <PublishAddin>true</PublishAddin>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Merged by ToadTools.Repack.targets instead of the SDK's IsRepackable (see the comment there) -->
  <PropertyGroup Condition="'$(RevitVersion)' &lt; '2027'">
    <RepackToadTools>true</RepackToadTools>
  </PropertyGroup>

  <Import Project="ToadTools.Repack.targets"/>

    <ItemGroup>
      <!-- Иконки ленты: {Плагин}16.png и {Плагин}32.png, берутся по имени в Application.WithIcon -->
      <None Remove="Resources\Icons\*.png" />
      <Resource Include="Resources\Icons\*.png" />
    </ItemGroup>

    <!-- Набор для ИИ-агента классификатора: инструкции и проверялка check.exe (net48, без Revit) → ToadTools\ClassifierCode\AiKit -->
    <ItemGroup>
      <Content Include="..\ClassifierCode\AiKit\**" PublishDirectory="ClassifierCode\AiKit" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="BuildClassifierCheck" BeforeTargets="PublishAddin" Condition="'$(PublishAddin)' == 'true'">
      <!-- Проект проверялки не собирается решением, поэтому и restore решения его не трогает: восстанавливаем сами.
           Своё глобальное свойство — чтобы Build после Restore перечитал проект с восстановленными пакетами. -->
      <MSBuild Projects="..\ClassifierCode.Check\ClassifierCode.Check.csproj" Targets="Restore" Properties="Configuration=Release;ClassifierCheckRestore=true" RemoveProperties="RevitVersion;TargetFramework" />
      <MSBuild Projects="..\ClassifierCode.Check\ClassifierCode.Check.csproj" Targets="Build" Properties="Configuration=Release" RemoveProperties="RevitVersion;TargetFramework">
        <Output TaskParameter="TargetOutputs" ItemName="_ClassifierCheckOutput" />
      </MSBuild>
      <ItemGroup>
        <_ClassifierCheckFiles Include="%(_ClassifierCheckOutput.RootDir)%(_ClassifierCheckOutput.Directory)*.dll;%(_ClassifierCheckOutput.RootDir)%(_ClassifierCheckOutput.Directory)*.exe;%(_ClassifierCheckOutput.RootDir)%(_ClassifierCheckOutput.Directory)*.exe.config" />
        <Content Include="@(_ClassifierCheckFiles)" PublishDirectory="ClassifierCode\AiKit\check" CopyToPublishDirectory="PreserveNewest" />
      </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <!-- Лента Revit (ComponentManager.ItemExecuted) — для счётчика запусков штатных команд -->
        <PackageReference Include="Nice3point.Revit.Api.AdWindows"/>
        <PackageReference Include="ILRepack" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CableTrays\CableTrays.csproj" />
      <ProjectReference Include="..\Collisions\Collisions.csproj" />
      <ProjectReference Include="..\Families\Families.csproj" />
      <ProjectReference Include="..\ChangeSharedFamilies\ChangeSharedFamilies.csproj" />
      <ProjectReference Include="..\ClassifierCode\ClassifierCode.csproj" />
      <ProjectReference Include="..\CreateCover\CreateCover.csproj" />
      <ProjectReference Include="..\CreateSpaces\CreateSpaces.csproj" />
      <ProjectReference Include="..\DoorSide\DoorSide.csproj" />
      <ProjectReference Include="..\ModelTransplanter\ModelTransplanter.csproj" />
      <ProjectReference Include="..\ParamChecker\ParamChecker.csproj" />
      <ProjectReference Include="..\ParamToFinish\ParamToFinish.csproj" />
      <ProjectReference Include="..\QuantityCheck\QuantityCheck.csproj" />
      <ProjectReference Include="..\ReinforcementByColor\ReinforcementByColor.csproj" />
      <ProjectReference Include="..\SmartTags\SmartTags.csproj" />
      <ProjectReference Include="..\SSPlan\SSPlan.csproj" />
      <ProjectReference Include="..\ToadExporter\ToadExporter.csproj" />
      <ProjectReference Include="..\ToadTools.Connection\ToadTools.Connection.csproj" />
      <ProjectReference Include="..\ToadTools.Telemetry\ToadTools.Telemetry.csproj" />
      <ProjectReference Include="..\WarmSync\WarmSync.csproj" />
      <ProjectReference Include="..\WorkingSet\WorkingSet.csproj" />
      <ProjectReference Include="..\WorksetCheck\WorksetCheck.csproj" />
      <ProjectReference Include="..\WriteDash\WriteDash.csproj" />
    </ItemGroup>

</Project>
