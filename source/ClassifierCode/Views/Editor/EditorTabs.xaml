<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toad="urn:toaddesign"
    xmlns:vm="clr-namespace:ClassifierCode.Editor.ViewModels"
    xmlns:models="clr-namespace:ClassifierCode.Models"
    xmlns:converters="clr-namespace:ClassifierCode.Converters"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI">

    <!-- ===================== Общее ===================== -->
    <DataTemplate DataType="{x:Type vm:GeneralTabViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Профиль" FontWeight="Bold" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Название" VerticalAlignment="Center" />
                    <toad:TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Версия" VerticalAlignment="Center" />
                    <toad:TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Width="120" HorizontalAlignment="Left" Text="{Binding Version}" />
                    <TextBlock Grid.Row="2" Text="Автор" VerticalAlignment="Center" />
                    <toad:TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Author}" />
                    <TextBlock Grid.Row="3" Text="Описание" VerticalAlignment="Top" Margin="0,8,0,0" />
                    <toad:TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Description}" />
                    <TextBlock Grid.Row="4" Text="Имя файла модели" VerticalAlignment="Top" Margin="0,8,0,0" TextWrapping="Wrap"
                               ToolTip="Профиль выбирается сам, если имя файла подходит под один из шаблонов (по шаблону в строке)" />
                    <toad:TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" MinHeight="48" AcceptsReturn="True"
                                  Placeholder="например: ШФТ*  — по шаблону в строке" Text="{Binding FileNamePatternsText}" />
                </Grid>

                <TextBlock Text="Куда записывать" FontWeight="Bold" Margin="0,16,0,6" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Поле позиции → параметр проекта. Описание можно не записывать (оставьте параметр пустым). GUID — если параметр общий и имя может отличаться." />
                <ItemsControl ItemsSource="{Binding Outputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OutputRowViewModel}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FieldTitle}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" IsEditable="True" Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.ParameterNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          Text="{Binding Parameter, UpdateSourceTrigger=LostFocus}" />
                                <toad:TextBox Grid.Column="2" Placeholder="GUID (необязательно)" Text="{Binding GuidText}" />
                                <toad:Button Grid.Column="3" Margin="6,0,0,0" Icon="Trash" Variant="Subtle" ToolTip="Убрать колонку"
                                             Command="{Binding DataContext.RemoveOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}"
                                             Visibility="{Binding IsFixedField, Converter={uiConverters:InverseBooleanCollapsedVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <toad:Button Content="Добавить колонку" Icon="Plus" Variant="Subtle" HorizontalAlignment="Left" Margin="0,4,0,0"
                             ToolTip="Доп. колонка позиции (из импорта Excel) → свой параметр" Command="{Binding AddOutputCommand}" />

                <TextBlock Text="Категории" FontWeight="Bold" Margin="0,16,0,6" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItem}">
                            <CheckBox Width="280" Margin="0,2" Content="{Binding Title}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Group}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Классификатор ===================== -->
    <DataTemplate DataType="{x:Type vm:PositionsTabViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <toad:TextBox Placeholder="Поиск по коду или описанию" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <toad:Button Margin="8,0,0,0" Content="Из Excel…" Icon="FileImport" Command="{Binding ImportExcelCommand}" />
                    <toad:Button Margin="8,0,0,0" Content="Вставить" Icon="Clipboard" ToolTip="Скопируйте в Excel колонки «код» и «описание»" Command="{Binding PasteCommand}" />
                    <toad:Button Margin="8,0,0,0" Content="Позиция" Icon="Plus" Command="{Binding AddCommand}" />
                </StackPanel>
            </Grid>

            <toad:Card Grid.Row="1" Margin="0,0,0,8" Padding="12,10"
                       Visibility="{Binding HasPreview, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                <StackPanel DataContext="{Binding Preview}">
                    <TextBlock FontWeight="Bold" Text="{Binding Source, StringFormat=Импорт из {0}}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <TextBlock Text="Код:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="200" ItemsSource="{Binding Columns}" SelectedIndex="{Binding CodeColumn}" />
                        <TextBlock Text="Описание:" VerticalAlignment="Center" Margin="14,0,6,0" />
                        <ComboBox Width="200" ItemsSource="{Binding Columns}" SelectedIndex="{Binding DescriptionColumn}" />
                        <TextBlock Text="С строки:" VerticalAlignment="Center" Margin="14,0,6,0" />
                        <toad:TextBox Width="60" Text="{Binding FirstRowNumber}" />
                        <CheckBox Margin="14,0,0,0" VerticalAlignment="Center" Content="Заменить классификатор целиком" IsChecked="{Binding Replace}" />
                    </WrapPanel>
                    <TextBlock Margin="0,6" Opacity="0.7" Text="{Binding Summary}" />
                    <DataGrid ItemsSource="{Binding Sample}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="200" />
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <toad:Button Content="Отмена" Variant="Subtle"
                                     Command="{Binding DataContext.CancelImportCommand, RelativeSource={RelativeSource AncestorType=toad:Card}}" />
                        <toad:Button Margin="8,0,0,0" Content="Загрузить" Icon="Check" Variant="Filled"
                                     Command="{Binding DataContext.ApplyImportCommand, RelativeSource={RelativeSource AncestorType=toad:Card}}" />
                    </StackPanel>
                </StackPanel>
            </toad:Card>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Visible}" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="200" />
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Доп. колонки" Binding="{Binding ExtraText, Mode=OneWay}" Width="140" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <toad:Button Icon="Trash" Variant="Subtle" ToolTip="Удалить позицию"
                                             Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                             CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <!-- ===================== Сопоставление ===================== -->
    <DataTemplate DataType="{x:Type vm:MappingTabViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="260" ItemsSource="{Binding Modes}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedMode}" />
                    <TextBlock Text="Раздел:" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <ComboBox Width="260" ItemsSource="{Binding DisciplineFilters}" SelectedItem="{Binding DisciplineFilter}" />
                    <toad:Button Margin="14,0,0,0" Content="Строка" Icon="Plus" Command="{Binding AddRowCommand}" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding SharedNote}"
                           Visibility="{Binding SharedNote, Converter={uiConverters:StringVisibilityConverter}}" />
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Раздел" Width="2*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DisciplineKeys, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding Discipline, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Тип элемента" Width="1.5*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.TypeKeys, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Код" Width="185">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.AllCodes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              Text="{Binding Position, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Позиция" Binding="{Binding DescriptionPreview, Mode=OneWay}" Width="1.3*" IsReadOnly="True" />
                        <DataGridTemplateColumn Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <toad:Button Icon="Trash" Variant="Subtle"
                                                 Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Возможные пробелы — сюда может прийти элемент, а позиции нет" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Gaps}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GapViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <toad:Button Grid.Column="1" Icon="Plus" Variant="Subtle" ToolTip="Добавить строку"
                                             Command="{Binding DataContext.AddFromGapCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" FontWeight="Bold" Margin="0,10,0,4" TextWrapping="Wrap"
                           Text="Замены: нет строки для типа — по очереди берутся эти типы" />
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Fallbacks}">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FallbackRowViewModel}">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding TypeTitle}" FontWeight="SemiBold" />
                                <toad:TextBox Text="{Binding AlternativesText}" ToolTip="Названия типов через «;» по порядку" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ===================== Слова и шифры ===================== -->
    <DataTemplate DataType="{x:Type vm:DictionariesTabViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:KeyItemViewModel}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock FontSize="{DynamicResource Toad.FontSize.Caption}" Opacity="0.6">
                                    <Run Text="{Binding KindTitle, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Key, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                    <toad:Button Content="Раздел" Icon="Plus" Variant="Subtle" Command="{Binding AddDisciplineCommand}" />
                    <toad:Button Content="Тип" Icon="Plus" Variant="Subtle" Command="{Binding AddTypeCommand}" />
                    <toad:Button Icon="Trash" Variant="Subtle" ToolTip="Удалить" Command="{Binding DeleteCommand}" />
                </WrapPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12">
                    <StackPanel DataContext="{Binding SelectedKey}">
                        <TextBlock Text="Название" Opacity="0.7" />
                        <toad:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                    </StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <toad:TextBox Placeholder="Ключ (латиницей, без пробелов)" Text="{Binding RenameTo, UpdateSourceTrigger=PropertyChanged}" />
                        <toad:Button Grid.Column="1" Margin="8,0,0,0" Content="Переименовать ключ" Icon="Pencil" Variant="Subtle"
                                     ToolTip="Ключ поменяется везде: в таблице, словарях, правилах, исключениях" Command="{Binding RenameCommand}" />
                    </Grid>

                    <TextBlock Text="Слова и шифры" FontWeight="Bold" Margin="0,8,0,4" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Записи словарей, которые дают этот раздел или тип. По шаблону в строке; «@имя» — набор, он раскрыт ниже и правится там." />
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                <toad:Card Margin="0,0,0,8" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding DictionaryName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding ModeTitle, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Opacity="0.7" Text="{Binding ResultNote}" Visibility="{Binding ResultNote, Converter={uiConverters:StringVisibilityConverter}}" />
                                        <toad:TextBox Margin="0,4,0,0" MinHeight="40" AcceptsReturn="True" FontFamily="Consolas" Text="{Binding PatternsText}" />
                                        <ItemsControl ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PatternSetViewModel}">
                                                    <StackPanel Margin="12,6,0,0">
                                                        <TextBlock Text="{Binding Name, StringFormat=Набор @{0}}" Opacity="0.7" />
                                                        <toad:TextBox MinHeight="40" MaxHeight="220" AcceptsReturn="True" FontFamily="Consolas"
                                                                      VerticalScrollBarVisibility="Auto" Text="{Binding PatternsText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </toad:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,0,0,10">
                        <ComboBox Width="220" ItemsSource="{Binding DictionaryNames}" SelectedItem="{Binding AddEntryDictionary}" />
                        <toad:Button Margin="8,0,0,0" Content="Добавить запись в словарь" Icon="Plus" Variant="Subtle" Command="{Binding AddEntryCommand}" />
                    </WrapPanel>

                    <TextBlock Text="Проверка текста" FontWeight="Bold" Margin="0,8,0,4" />
                    <toad:TextBox Placeholder="Вставьте наименование или имя системы — увидите, что совпало"
                                  Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Matches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Синтаксис шаблонов" FontWeight="Bold" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{x:Static vm:DictionariesTabViewModel.SyntaxHelp}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Consolas" Text="{Binding Pattern}" />
                                    <TextBlock Grid.Column="1" Opacity="0.8" TextWrapping="Wrap" Text="{Binding Meaning}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ===================== Режимы ===================== -->
    <DataTemplate DataType="{x:Type vm:ModesTabViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Title" />
                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                    <toad:Button Content="Копия" Icon="Plus" Variant="Subtle" Command="{Binding AddCommand}" />
                    <toad:Button Icon="ArrowUp" Variant="Subtle" ToolTip="Выше" Command="{Binding MoveUpCommand}" />
                    <toad:Button Icon="ArrowDown" Variant="Subtle" ToolTip="Ниже" Command="{Binding MoveDownCommand}" />
                    <toad:Button Icon="Trash" Variant="Subtle" ToolTip="Удалить" Command="{Binding DeleteCommand}" />
                </WrapPanel>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,12,12" DataContext="{Binding SelectedMode}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Название" VerticalAlignment="Center" />
                    <toad:TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Подсказка в окне" VerticalAlignment="Center" />
                    <toad:TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Hint}" />
                    <TextBlock Grid.Row="2" Text="Описание для отчёта" VerticalAlignment="Center" />
                    <toad:TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding ReportMode}" />
                    <TextBlock Grid.Row="3" Text="Шифры в имени файла" VerticalAlignment="Center" />
                    <toad:TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Placeholder="ОВВ, ВЕНТ — через запятую" Text="{Binding FileTokensText}" />
                    <TextBlock Grid.Row="4" Text="Раздел по умолчанию" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,2"
                              ItemsSource="{Binding DataContext.DisciplineOptions, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                              SelectedValuePath="Key" SelectedValue="{Binding DefaultDiscipline}" />
                    <TextBlock Grid.Row="5" Text="Правила типов" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2"
                              ItemsSource="{Binding DataContext.RuleSetNames, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                              SelectedItem="{Binding TypeRules}" />
                    <TextBlock Grid.Row="6" Text="Таблица кодов" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,2"
                              ItemsSource="{Binding DataContext.TableNames, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                              SelectedItem="{Binding Table}" />
                    <CheckBox Grid.Row="7" Grid.Column="1" Margin="0,8" IsChecked="{Binding UnconnectedAsAir}"
                              Content="Неподключённые элементы считать воздуховодами (крепёж → «Воздуховоды»)" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ===================== Исключения ===================== -->
    <DataTemplate DataType="{x:Type vm:ExceptionsTabViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Срабатывают раньше распознавания, сверху вниз; первое подошедшее решает." />
                <ListBox Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Title" />
                <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                    <toad:Button Content="Новое" Icon="Plus" Variant="Subtle" Command="{Binding AddCommand}" />
                    <toad:Button Icon="Copy" Variant="Subtle" ToolTip="Копия" Command="{Binding DuplicateCommand}" />
                    <toad:Button Icon="ArrowUp" Variant="Subtle" ToolTip="Выше" Command="{Binding MoveUpCommand}" />
                    <toad:Button Icon="ArrowDown" Variant="Subtle" ToolTip="Ниже" Command="{Binding MoveDownCommand}" />
                    <toad:Button Icon="Trash" Variant="Subtle" ToolTip="Удалить" Command="{Binding DeleteCommand}" />
                </WrapPanel>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12" DataContext="{Binding SelectedRule}">
                    <TextBlock Text="Название" Opacity="0.7" />
                    <toad:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <StackPanel Visibility="{Binding IsSimple, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                        <TextBlock Text="Если (все условия сразу)" FontWeight="Bold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Conditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConditionViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{x:Static vm:ConditionViewModel.Kinds}" DisplayMemberPath="Title" SelectedValuePath="Kind"
                                                  SelectedValue="{Binding Kind}" IsEnabled="{Binding IsEditable}" />
                                        <CheckBox Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Content="не" IsChecked="{Binding Not}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <ComboBox Width="150" Margin="0,0,6,0" ItemsSource="{Binding SourceNames}" SelectedItem="{Binding SourceName}"
                                                      Visibility="{Binding IsText, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                                            <ComboBox Width="190" Margin="0,0,6,0" IsEditable="True"
                                                      ItemsSource="{Binding DataContext.ParameterNames, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                      Text="{Binding ParameterName, UpdateSourceTrigger=LostFocus}"
                                                      Visibility="{Binding IsParameter, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                                        </StackPanel>
                                        <toad:TextBox Grid.Column="3" Text="{Binding Value}" IsEnabled="{Binding IsEditable}"
                                                      ToolTip="Категории, режимы, типы — через запятую (OST_PipeCurves, …); текст — шаблон" />
                                        <toad:Button Grid.Column="4" Margin="6,0,0,0" Icon="Trash" Variant="Subtle"
                                                     Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <toad:Button Content="Условие" Icon="Plus" Variant="Subtle" HorizontalAlignment="Left" Margin="0,4,0,8" Command="{Binding AddConditionCommand}" />
                        <TextBlock Text="То" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{x:Static vm:ExceptionRuleViewModel.Actions}" DisplayMemberPath="Title" SelectedValuePath="Kind"
                                      SelectedValue="{Binding ActionKind}" />
                            <toad:TextBox Grid.Column="1" Margin="8,0,0,0" Placeholder="Код позиции, причина или ключ" Text="{Binding ActionValue}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" Text="Это правило со сложными шагами — оно правится в JSON (экспорт профиля)."
                               Visibility="{Binding IsSimple, Converter={uiConverters:InverseBooleanCollapsedVisibilityConverter}}" />
                    <TextBlock Text="Как читается" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ===================== Логика ===================== -->
    <DataTemplate DataType="{x:Type vm:LogicTabViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="260" ItemsSource="{Binding Modes}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedMode}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding SharedNote}" />
            </WrapPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Как определяется тип" FontWeight="Bold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding TypeRulesDescription}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Как определяется раздел" FontWeight="Bold" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding DisciplineRulesDescription}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Правка (JSON)" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="{DynamicResource Toad.FontSize.Small}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="IndianRed" TextWrapping="Wrap" Text="{Binding ApplyError}"
                               Visibility="{Binding ApplyError, Converter={uiConverters:StringVisibilityConverter}}" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <toad:Button Content="Сбросить" Variant="Subtle" Command="{Binding ResetCommand}" />
                        <toad:Button Margin="8,0,0,0" Content="Применить" Icon="Check" Variant="Filled" Command="{Binding ApplyCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ===================== Проверка ===================== -->
    <DataTemplate DataType="{x:Type vm:CheckTabViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="260" ItemsSource="{Binding Modes}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedMode}" />
                <toad:Button Margin="12,0,0,0" Icon="Click" Content="Выбрать в модели…" Variant="Filled" Command="{Binding PickCommand}"
                             ToolTip="Окна свернутся; выберите элементы и нажмите «Готово» на панели параметров Revit" />
                <toad:Button Margin="8,0,0,0" Icon="Pointer" Content="{Binding SelectionLabel}" IsEnabled="{Binding HasSelection}" Command="{Binding InspectSelectionCommand}" />
            </WrapPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                <RadioButton GroupName="DryRunScope" Content="Вся модель" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsChecked="{Binding Scope, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunScope.Model}}" />
                <RadioButton GroupName="DryRunScope" Content="Активный вид" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsChecked="{Binding Scope, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunScope.ActiveView}}" />
                <RadioButton GroupName="DryRunScope" Content="Выделенные" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsChecked="{Binding Scope, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunScope.Selection}}" />
                <toad:Button Icon="PlayerPlay" Content="Прогон без записи" Variant="Filled" Command="{Binding DryRunCommand}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.75" Text="{Binding Summary}" />
            </WrapPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,4">
                        <CheckBox Content="только изменения" Margin="0,0,12,0" IsChecked="{Binding OnlyChanges}" />
                        <CheckBox Content="не классифицированные" Margin="0,0,12,0" IsChecked="{Binding OnlyUnclassified}" />
                        <CheckBox Content="пропущенные" Margin="0,0,12,0" IsChecked="{Binding OnlySkipped}" />
                        <toad:Button Icon="Click" Content="Выделить в модели" Variant="Subtle" Command="{Binding SelectInModelCommand}"
                                     ToolTip="Выделит показанные элементы — видно после закрытия окон" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Элемент" Binding="{Binding Label}" Width="2*" MinWidth="120" />
                            <DataGridTextColumn Header="Сейчас" Binding="{Binding Current}" Width="132" />
                            <DataGridTextColumn Header="Станет" Binding="{Binding New}" Width="132" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="145" />
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ItemsControl Grid.Row="2" MaxHeight="120" Margin="0,6,0,0" ItemsSource="{Binding Groups}">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CodeGroup}">
                                <TextBlock>
                                    <Run Text="{Binding Code, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" " /><Run Text="{Binding Description, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Count, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Inspected}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ElementCheck}">
                                <toad:Card Margin="0,0,0,8" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ResultText}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,6" />
                                        <ItemsControl ItemsSource="{Binding Trace}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,1">
                                                        <Run Text="{Binding Stage, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander Header="Что известно об элементе" Margin="0,6,0,0">
                                            <ItemsControl ItemsSource="{Binding Facts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FactRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Opacity="0.7" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </toad:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
