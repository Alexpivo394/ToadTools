<Project Sdk="Microsoft.NET.Sdk">

    <!-- Тесты общего подключения к ToadFlow и плагина «Коллизии» без Revit API: файлы ядра подключаются ссылками,
         поэтому проекту не нужны ни Revit SDK, ни Revit-конфигурации. -->
    <PropertyGroup>
        <!-- net48 — как ToadTools в Revit 2020–2024: тот же код под старым .NET Framework -->
        <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- source/Directory.Build.props включает WPF и Revit API всем проектам — тестам они не нужны -->
        <UseWPF>false</UseWPF>
        <RevitVersion>2027</RevitVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Remove="Nice3point.Revit.Toolkit;Nice3point.Revit.Extensions;Nice3point.Revit.Api.RevitAPI;Nice3point.Revit.Api.RevitAPIUI"/>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Newtonsoft.Json"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
    </ItemGroup>

    <!-- Покрытие кода TUnit под net48 требует System.Text.Json не ниже 10.0.10; аддину хватает общей версии -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="System.Text.Json" VersionOverride="10.0.10"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\ToadTools.Connection\Core\**\*.cs" Link="Linked\Connection\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\ToadTools.Connection\ViewModels\**\*.cs" Link="Linked\ConnectionViewModels\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\Collisions\Core\**\*.cs" Link="Linked\Collisions\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\Collisions\ViewModels\**\*.cs" Link="Linked\CollisionsViewModels\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <Reference Include="System.Net.Http"/>
        <Using Include="System.Net.Http"/>
    </ItemGroup>

    <!-- Ответы сервера ToadFlow (задача 3 этапа 7), снятые с живого маршрута -->
    <ItemGroup>
        <None Include="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
