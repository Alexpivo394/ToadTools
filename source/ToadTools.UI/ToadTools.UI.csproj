<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <!-- Shared UI library: a plain class library (no repack). Its dependencies ship as loose DLLs
         and each add-in loads them in its isolated context (EnableDynamicLoading). -->
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Newtonsoft.Json"/>
        <PackageReference Include="WPF-UI"/>
        <PackageReference Include="WPF-UI.Abstractions"/>
    </ItemGroup>

    <!-- Клиент Revit Server (дерево моделей), общий с ToadFlow -->
    <ItemGroup>
        <PackageReference Include="Alexpivo394.Revit.Export.Sources"/>
    </ItemGroup>

    <!-- HttpClient для REST API Revit Server; на .NET входит в рантайм -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETFramework'">
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

</Project>
