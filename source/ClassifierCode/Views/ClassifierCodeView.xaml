<ui:FluentWindow
    x:Class="ClassifierCode.Views.ClassifierCodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ClassifierCode.ViewModels"
    xmlns:models="clr-namespace:ClassifierCode.Models"
    xmlns:converters="clr-namespace:ClassifierCode.Converters"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:ClassifierCodeViewModel}"
    mc:Ignorable="d"
    Title="Код по классификатору"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Height="680"
    Width="640"
    MinHeight="560"
    MinWidth="560"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="Код по классификатору" Icon="Tag24" />

        <!-- Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="10,0,0,10"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding DocumentTitle, StringFormat=Документ: {0}}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,10">
                <TextBlock Text="Раздел модели" FontWeight="Bold" />
                <TextBlock Text=" (определён по имени файла)"
                           Opacity="0.7"
                           Visibility="{Binding IsSectionDetected, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
            </StackPanel>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SectionOption}">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Hint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" Text="Область" FontWeight="Bold" Margin="10,10,0,5" />

            <StackPanel Grid.Row="4" Margin="10,0,0,0">
                <RadioButton GroupName="Scope"
                             Content="Вся модель"
                             IsChecked="{Binding Scope, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunScope.Model}}" />
                <RadioButton GroupName="Scope"
                             Content="Элементы на активном виде"
                             IsChecked="{Binding Scope, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunScope.ActiveView}}" />
                <RadioButton GroupName="Scope"
                             Content="{Binding SelectionLabel}"
                             IsEnabled="{Binding HasSelection}"
                             IsChecked="{Binding Scope, Converter={converters:EnumRadioConverter}, ConverterParameter={x:Static models:RunScope.Selection}}" />
            </StackPanel>

            <CheckBox Grid.Row="5"
                      Margin="10,10,0,0"
                      Content="Не перезаписывать уже заполненные значения"
                      IsChecked="{Binding KeepExisting, Mode=TwoWay}" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <ui:Button Content="Заполнить"
                           Icon="{ui:SymbolIcon Rocket24}"
                           Command="{Binding StartCommand}"
                           Appearance="Primary"
                           Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10">
            <TextBlock Text="Тема:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ui:ToggleSwitch
                IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=TwoWay}"
                OffContent="Светлая"
                OnContent="Темная"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
