<toad:ToadWindow x:Class="ToadTools.UI.Views.ToadDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:toad="urn:toaddesign"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:m="clr-namespace:ToadTools.UI.Models"
                 xmlns:vm="clr-namespace:ToadTools.UI.ViewModels"
                 d:DataContext="{d:DesignInstance Type=vm:ToadDialogViewModel}"
                 mc:Ignorable="d"
                 Title="{Binding Title}"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowMinimizeButton="False"
                 ShowMaximizeButton="False"
                 SizeToContent="Height"
                 Width="420">

    <DockPanel Margin="20,6,20,18">
        <!-- Buttons: the first one (OK, Yes, ...) is the main action -->
        <ItemsControl DockPanel.Dock="Bottom" Margin="0,18,0,0" ItemsSource="{Binding Buttons}" AlternationCount="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type m:DialogButtonModel}">
                    <toad:Button x:Name="Action" Content="{Binding Text}" Icon="{Binding Icon}" MinWidth="90"
                                 Margin="8,0,0,0" Command="{Binding Command}" />
                    <DataTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter TargetName="Action" Property="Variant" Value="Filled" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <toad:Icon DockPanel.Dock="Left" Symbol="{Binding Icon}" Width="28" Height="28" Margin="0,0,14,0"
                   VerticalAlignment="Top">
            <toad:Icon.Style>
                <Style TargetType="toad:Icon">
                    <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static toad:Symbol.InfoCircle}">
                            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Info}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static toad:Symbol.AlertTriangle}">
                            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static toad:Symbol.CircleX}">
                            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </toad:Icon.Style>
        </toad:Icon>

        <ScrollViewer x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</toad:ToadWindow>
