<toad:ToadWindow
    xmlns:toad="urn:toaddesign"
    x:Class="WorkingSet.Views.WorkingSetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="Создание рабочих наборов"
    Height="300"
    Width="400"
    MinHeight="300"
    MinWidth="400"
    TitleIcon="CirclePlus">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Выберите файл с рабочими наборами" 
                          HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,5"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            
                <toad:TextBox Grid.Column="0" Text="{Binding ExcelFilePath, Mode=TwoWay}"
                            Placeholder="Путь к Excel файлу с рабочими наборами"   
                            IsReadOnly="False"
                            Height="35"
                            VerticalContentAlignment="Center"
                            Margin="0,0,5,0" />
                <toad:Button Grid.Column="1" Icon="Dots"
                           Width="40"
                           Height="35"
                           Command="{Binding SelectExcelFilePathCommand}" />
            </Grid>
      
            <TextBlock Grid.Row="2" Text="Выберите раздел проекта" 
                          HorizontalAlignment="Center" FontSize="14" Margin="0,10,0,5"/>

            <ComboBox Grid.Row="3" ItemsSource="{Binding Sections, Mode=TwoWay}" 
                      SelectedItem="{Binding SelectedSection, Mode=TwoWay}"/>

            <toad:Button Grid.Row="4" Content="Создать" 
                       Command="{Binding CreateWorksetsCommand}"
                       Icon="PlayerPlay"
                       Variant="Filled"
                       Width="120" Height="45" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="5,0,0,0">
                <toad:Switch Content="Тёмная тема"
                    IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
            </StackPanel>
        
        </Grid>
    </Grid>

</toad:ToadWindow>