<ui:FluentWindow
    x:Class="ParamChecker.Views.ParamCheckerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    xmlns:views="clr-namespace:ParamChecker.Views"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
    mc:Ignorable="d"
    Title="ParamChecker"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Height="780"
    Width="1200"
    MinHeight="600"
    MinWidth="960"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ParamChecker" Icon="DocumentSearch24" />

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Профили -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Профили" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Добавить" Icon="{ui:SymbolIcon Add24}" Appearance="Transparent"
                                   Command="{Binding AddProfileCommand}" />
                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="Удалить все профили"
                                   Command="{Binding ClearProfilesCommand}" />
                    </StackPanel>
                </Grid>

                <ui:Card Grid.Row="1" Padding="4" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalContentAlignment="Stretch"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ProfileViewModel}">
                                    <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}"
                                                          Icon="{ui:SymbolIcon Copy24}" />
                                                <MenuItem Header="Удалить" Command="{Binding RemoveCommand}"
                                                          Icon="{ui:SymbolIcon Delete24}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled}" ToolTip="Проверять при запуске" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Профилей нет.&#10;Добавьте профиль или загрузите&#10;кнопкой «Импорт»."
                                   TextAlignment="Center" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Profiles.Count, Converter={views:ZeroVisibleConverter}}" />
                    </Grid>
                </ui:Card>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <UniformGrid Columns="2">
                        <ui:Button Content="Импорт" Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Stretch"
                                   ToolTip="Загрузить профили из файла .json (в том числе из прежних версий ParamChecker)"
                                   Command="{Binding ImportCommand}" />
                        <ui:Button Content="Экспорт" Icon="{ui:SymbolIcon Save24}" HorizontalAlignment="Stretch" Margin="6,0,0,0"
                                   ToolTip="Сохранить все профили в файл .json — чтобы поделиться с коллегами"
                                   Command="{Binding ExportCommand}" />
                    </UniformGrid>
                    <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="Настройки"
                               Icon="{ui:SymbolIcon Settings24}"
                               Appearance="{Binding IsSettingsOpen, Converter={views:SelectedAppearanceConverter}}"
                               Command="{Binding ToggleSettingsCommand}" />
                </StackPanel>
            </Grid>

            <!-- Профиль или настройки -->
            <Grid Grid.Column="2">
                <views:ProfileView DataContext="{Binding SelectedProfile}"
                                   Visibility="{Binding DataContext.ShowProfile, RelativeSource={RelativeSource AncestorType=Window}, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                <views:SettingsView Visibility="{Binding IsSettingsOpen, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="48" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,12,0,0" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="Профиль — это модели и правила их проверки. Удобно заводить по профилю на раздел или объект." />
                    <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="Создать профиль"
                               Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding AddProfileCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Подвал -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding RunHint}" />
            <ui:Button Grid.Column="1" Margin="0,0,8,0"
                       Content="Проверить открытую модель"
                       Icon="{ui:SymbolIcon DocumentCheckmark24}"
                       ToolTip="Проверить модель, открытую сейчас в Revit, по правилам выбранного профиля — без открытия моделей профиля"
                       Command="{Binding RunActiveCommand}" />
            <ui:Button Grid.Column="2"
                       Content="{Binding RunText}"
                       Icon="{ui:SymbolIcon Play24}"
                       ToolTip="Открыть по очереди модели отмеченных профилей и проверить их"
                       Command="{Binding RunCommand}"
                       Appearance="Primary" />
        </Grid>
    </Grid>
</ui:FluentWindow>
