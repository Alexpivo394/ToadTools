<Project Sdk="Microsoft.NET.Sdk">

    <!-- Тесты логики ParamChecker без Revit API: файлы Core подключаются ссылками,
         поэтому проекту не нужны ни Revit SDK, ни Revit-конфигурации. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- source/Directory.Build.props включает WPF и Revit API всем проектам — тестам они не нужны -->
        <UseWPF>false</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Remove="Nice3point.Revit.Toolkit;Nice3point.Revit.Extensions;Nice3point.Revit.Api.RevitAPI;Nice3point.Revit.Api.RevitAPIUI"/>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="EPPlus"/>
        <PackageReference Include="Newtonsoft.Json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\ParamChecker\Core\**\*.cs" Link="Linked\Core\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
