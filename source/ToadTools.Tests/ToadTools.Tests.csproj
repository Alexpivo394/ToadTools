<Project Sdk="Microsoft.NET.Sdk">

    <!-- Тесты общего подключения к ToadFlow и плагина «Коллизии» без Revit API: файлы ядра подключаются ссылками,
         поэтому проекту не нужны ни Revit SDK, ни Revit-конфигурации. -->
    <PropertyGroup>
        <!-- net48 — как ToadTools в Revit 2020–2024: тот же код под старым .NET Framework -->
        <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- source/Directory.Build.props включает WPF и Revit API всем проектам — тестам они не нужны -->
        <UseWPF>false</UseWPF>
        <RevitVersion>2027</RevitVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Remove="Nice3point.Revit.Toolkit;Nice3point.Revit.Extensions;Nice3point.Revit.Api.RevitAPI;Nice3point.Revit.Api.RevitAPIUI"/>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="ClosedXML"/>
        <!-- Хеш файла семейства (FamilyHash) для панели «Семейства»: часть ядра без Revit -->
        <PackageReference Include="Alexpivo394.Revit.Families.Files"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
    </ItemGroup>

    <!-- На .NET входит в рантайм -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="System.Text.Json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\ToadTools.Connection\Core\**\*.cs" Link="Linked\Connection\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\ToadTools.Connection\ViewModels\**\*.cs" Link="Linked\ConnectionViewModels\%(RecursiveDir)%(Filename)%(Extension)"/>
        <!-- Журнал из ToadTools.UI: файлы без WPF и Revit API -->
        <Compile Include="..\ToadTools.UI\Services\ToadLog.cs;..\ToadTools.UI\Services\LogSettings.cs;..\ToadTools.UI\Services\SettingsJson.cs;..\ToadTools.UI\Services\DensityChoice.cs;..\ToadTools.UI\Services\ThemePreference.Parse.cs" Link="Linked\Log\%(Filename)%(Extension)"/>
        <Compile Include="..\ToadTools.Telemetry\Core\**\*.cs" Link="Linked\Telemetry\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\Collisions\Core\**\*.cs" Link="Linked\Collisions\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\Collisions\ViewModels\**\*.cs" Link="Linked\CollisionsViewModels\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\Families\Core\**\*.cs" Link="Linked\Families\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\Families\ViewModels\**\*.cs" Link="Linked\FamiliesViewModels\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\ClassifierCode\Engine\**\*.cs" Link="Linked\ClassifierCode\Engine\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\ClassifierCode\Editor\**\*.cs" Link="Linked\ClassifierCode\Editor\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\ClassifierCode\Models\RunScope.cs" Link="Linked\ClassifierCode\RunScope.cs"/>
        <Compile Include="..\ClassifierCode.Check\CheckCli.cs" Link="Linked\ClassifierCode\Check\CheckCli.cs"/>
        <Compile Include="..\ClassifierCode.Check\XlsxRows.cs" Link="Linked\ClassifierCode\Check\XlsxRows.cs"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <Reference Include="System.Net.Http"/>
        <Using Include="System.Net.Http"/>
    </ItemGroup>

    <!-- Ответы сервера ToadFlow (задача 3 этапа 7), снятые с живого маршрута -->
    <ItemGroup>
        <None Include="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\ClassifierCode\Profiles\Builtin\*.json" Link="TestData\ClassifierCode\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\ClassifierCode\AiKit\*" Link="TestData\ClassifierCode\AiKit\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
