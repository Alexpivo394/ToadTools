<ui:FluentWindow
    x:Class="SmartTags.Views.SmartTagsReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:SmartTags.ViewModels"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:SmartTagsReportViewModel}"
    mc:Ignorable="d"
    Title="Умные выноски — отчёт"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Height="680"
    Width="760"
    MinHeight="440"
    MinWidth="600"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="Умные выноски" Icon="TagMultiple24" />

        <!-- Content -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="10,0,0,10"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Text="{Binding Headline}" />

            <ui:InfoBar Grid.Row="1"
                        Margin="0,0,0,10"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="{Binding Severity}"
                        Message="{Binding Message}" />

            <!-- Counters -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Counters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ReportCounter}">
                        <ui:Card Margin="0,0,8,0" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Label}" Opacity="0.7" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Why not placed -->
            <ItemsControl Grid.Row="3"
                          Margin="10,10,0,0"
                          ItemsSource="{Binding Reasons}"
                          Visibility="{Binding HasReasons, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=• {0}}" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="4"
                       Margin="10,8,0,0"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="{Binding Statistics}" />

            <TextBlock Grid.Row="5"
                       Margin="10,12,0,5"
                       Visibility="{Binding HasItems, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                <Run Text="Подробности" FontWeight="Bold" />
                <Run Text=" — двойной щелчок по строке выделит элементы в модели" />
            </TextBlock>

            <DataGrid Grid.Row="6"
                      x:Name="DetailsGrid"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      Visibility="{Binding HasItems, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Элемент" Binding="{Binding Label}" Width="2*" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="Auto" />
                    <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,10,10">
            <ui:Button Content="Открыть журнал"
                       Icon="{ui:SymbolIcon DocumentText24}"
                       Command="{Binding OpenLogCommand}"
                       Visibility="{Binding HasLog, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}"
                       Margin="10,0,0,0" />
            <ui:Button Content="{Binding SelectProblemsLabel}"
                       Icon="{ui:SymbolIcon CursorClick24}"
                       Command="{Binding SelectProblemsCommand}"
                       Visibility="{Binding HasProblems, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}"
                       Margin="10,0,0,0" />
            <ui:Button Content="Закрыть"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding CloseCommand}"
                       Appearance="Primary"
                       Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
