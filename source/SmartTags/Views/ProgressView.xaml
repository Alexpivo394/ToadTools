<ui:FluentWindow
    x:Class="SmartTags.Views.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:SmartTags.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ProgressViewModel}"
    mc:Ignorable="d"
    Title="Умные выноски"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Width="460"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0"
                     Title="Умные выноски"
                     Icon="TagMultiple24"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,16">
            <TextBlock Text="{Binding StageText}" FontSize="16" FontWeight="SemiBold" />
            <ProgressBar Margin="0,12,0,8"
                         Height="6"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Maximum="{Binding Maximum}"
                         Value="{Binding Value}" />
            <TextBlock Text="{Binding Detail}" Opacity="0.7" TextTrimming="CharacterEllipsis" MinHeight="18" />
            <ui:Button Margin="0,12,0,0"
                       HorizontalAlignment="Right"
                       Content="Отмена"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
