<ui:FluentWindow
    x:Class="ParamChecker.Views.FilterEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    xmlns:views="clr-namespace:ParamChecker.Views"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:FilterEditorViewModel}"
    mc:Ignorable="d"
    Title="{Binding Title}"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Height="720"
    Width="1100"
    MinHeight="520"
    MinWidth="860"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <uiConverters:EnumDescriptionConverter x:Key="EnumDescription" />

        <!-- Длинный список без выделения строк: прокрутка и виртуализация, как у ListBox -->
        <Style x:Key="VirtualList" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
        </DataTemplate>

        <!-- Условие: параметр — оператор — значение -->
        <DataTemplate x:Key="ConditionRow" DataType="{x:Type viewModels:ConditionItemViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <ui:AutoSuggestBox OriginalItemsSource="{Binding Editor.ParameterNames}"
                                       Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       PlaceholderText="Имя параметра" Icon="{x:Null}" />
                    <ui:SymbolIcon Symbol="Warning20" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   ToolTip="Такого имени нет в ФОП, в открытом проекте и среди системных параметров — проверьте, нет ли опечатки"
                                   Visibility="{Binding IsUnknown, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                </Grid>
                <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding Editor.Operators}"
                          SelectedItem="{Binding Operator}" ItemTemplate="{StaticResource EnumItem}" />
                <ui:TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Значение"
                            ToolTip="Без учёта регистра. Для сравнения чисел — число в единицах проекта: «1000» для 1000 мм"
                            Visibility="{Binding NeedsValue, Converter={uiConverters:BooleanHiddenVisibilityConverter}}" />
                <ui:Button Grid.Column="3" Margin="4,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                           ToolTip="Удалить условие" Command="{Binding RemoveCommand}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ConditionItemViewModel}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ConditionRow}" />
        </DataTemplate>

        <!-- Группа: все условия через «И» -->
        <DataTemplate DataType="{x:Type viewModels:ConditionGroupViewModel}">
            <Border Margin="0,4" Padding="10,6" CornerRadius="6" BorderThickness="3,1,1,1"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Группа — должны выполняться все её условия (И)" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="Условие" Icon="{ui:SymbolIcon Add16}" Appearance="Transparent"
                                   Command="{Binding AddCommand}" />
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete20}" Appearance="Transparent"
                                   ToolTip="Удалить группу" Command="{Binding RemoveGroupCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource ConditionRow}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" Icon="Filter24" ShowMinimize="False" />

        <!-- Как отбирать -->
        <ui:Card Grid.Row="1" Margin="10,0,10,10" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Отбирать" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" ItemTemplate="{StaticResource EnumItem}" />
                <TextBlock Grid.Column="2" Margin="14,0,0,0" Text="{Binding ModeHint}" Opacity="0.75" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Категории -->
            <Grid Grid.Column="0" IsEnabled="{Binding ShowCategories}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Grid.Row="0" Margin="10,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Категории" FontWeight="Bold" />
                        <Run Text="· выбрано" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </TextBlock>
                    <ui:Button Grid.Column="1" Content="Снять все" Appearance="Transparent" Command="{Binding ClearCategoriesCommand}" />
                </Grid>
                <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBox Grid.Row="0" Margin="8,8,8,4" PlaceholderText="Поиск категории" Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Grid.Row="1" Margin="10,0,8,4" Content="Только выбранные" IsChecked="{Binding SelectedOnly}" />
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding VisibleCategories}" Margin="10,0,4,6"
                                      Style="{StaticResource VirtualList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:CategoryItemViewModel}">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" MinHeight="28" Padding="6,0,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Условия -->
            <Grid Grid.Column="2" IsEnabled="{Binding ShowConditions}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Grid.Row="0" Margin="10,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Условия на параметры" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Связь условий" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Logics}" SelectedItem="{Binding Logic}" ItemTemplate="{StaticResource EnumItem}" />
                </Grid>
                <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Conditions}" Margin="12,8" />
                        </ScrollViewer>
                        <TextBlock Grid.Row="0" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Условий нет. Например: «ADSK_Наименование» равно «Воздуховод» — проверятся только такие элементы. Значения сравниваются без учёта регистра, числа — в единицах проекта."
                                   Visibility="{Binding Conditions.Count, Converter={views:ZeroVisibleConverter}}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,10">
                            <ui:Button Content="Условие" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddConditionCommand}" />
                            <ui:Button Content="Группа условий" Icon="{ui:SymbolIcon GroupList24}" Margin="8,0,0,0"
                                       ToolTip="Несколько условий, которые должны выполняться вместе. Пригодится при связи «Любое условие (ИЛИ)»"
                                       Command="{Binding AddGroupCommand}" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <ui:Button Content="Отмена" Icon="{ui:SymbolIcon Dismiss24}" IsCancel="True" Click="OnCancel" />
            <ui:Button Content="Применить" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Margin="8,0,0,0"
                       IsDefault="False" Click="OnApply" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
