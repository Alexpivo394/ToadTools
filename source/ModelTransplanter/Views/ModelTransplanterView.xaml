<toad:ToadWindow
    x:Class="ModelTransplanter.Views.ModelTransplanterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:themes="clr-namespace:ToadTools.UI.Services;assembly=ToadTools.UI"
    xmlns:converters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    mc:Ignorable="d"
    Title="Копирование элементов"
    WindowStartupLocation="CenterScreen"
    Height="400"
    Width="400"
    MinHeight="350"
    MinWidth="350"
    TitleIcon="CirclePlus">

    <DockPanel Margin="20,6,20,18">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <toad:Button DockPanel.Dock="Right" Content="Начать перенос" Icon="Rocket" Variant="Filled"
                         Command="{Binding TransferElementsCommand}"
                         IsEnabled="{Binding IsBusy, Converter={converters:InverseBoolConverter}}" />
            <toad:Switch Content="Тёмная тема" VerticalAlignment="Center"
                         IsChecked="{Binding IsDark, Source={x:Static themes:ThemePreference.Instance}}" />
        </DockPanel>

        <StackPanel>
            <TextBlock Text="Исходная модель" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding OpenDocuments}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedSourceDoc}" />

            <TextBlock Text="Целевая модель" FontWeight="SemiBold" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding OpenDocuments}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedTargetDoc}" />

            <TextBlock Text="Путь к лог-файлу" FontWeight="SemiBold" Margin="0,14,0,6" />
            <DockPanel>
                <toad:Button DockPanel.Dock="Right" Icon="FolderOpen" Margin="8,0,0,0" ToolTip="Куда сохранить лог-файл"
                             Command="{Binding SelectLogPathCommand}" />
                <toad:TextBox Text="{Binding LogFilePath, Mode=OneWay}" IsReadOnly="True" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</toad:ToadWindow>
