<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

  <PropertyGroup>
    <PublishAddin>true</PublishAddin>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Merged by ToadTools.Repack.targets instead of the SDK's IsRepackable (see the comment there) -->
  <PropertyGroup Condition="'$(RevitVersion)' &lt; '2027'">
    <RepackToadTools>true</RepackToadTools>
    <RepackBinariesExcludes>Wpf*.dll</RepackBinariesExcludes>
  </PropertyGroup>

  <Import Project="ToadTools.Repack.targets"/>

    <ItemGroup>
      <!-- Иконки ленты: {Плагин}16.png и {Плагин}32.png, берутся по имени в Application.WithIcon -->
      <None Remove="Resources\Icons\*.png" />
      <Resource Include="Resources\Icons\*.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="ILRepack" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CableTrays\CableTrays.csproj" />
      <ProjectReference Include="..\Collisions\Collisions.csproj" />
      <ProjectReference Include="..\ChangeSharedFamilies\ChangeSharedFamilies.csproj" />
      <ProjectReference Include="..\ClassifierCode\ClassifierCode.csproj" />
      <ProjectReference Include="..\CreateCover\CreateCover.csproj" />
      <ProjectReference Include="..\CreateSpaces\CreateSpaces.csproj" />
      <ProjectReference Include="..\DoorSide\DoorSide.csproj" />
      <ProjectReference Include="..\ModelTransplanter\ModelTransplanter.csproj" />
      <ProjectReference Include="..\ParamChecker\ParamChecker.csproj" />
      <ProjectReference Include="..\ParamToFinish\ParamToFinish.csproj" />
      <ProjectReference Include="..\QuantityCheck\QuantityCheck.csproj" />
      <ProjectReference Include="..\ReinforcementByColor\ReinforcementByColor.csproj" />
      <ProjectReference Include="..\SmartTags\SmartTags.csproj" />
      <ProjectReference Include="..\SSPlan\SSPlan.csproj" />
      <ProjectReference Include="..\ToadExporter\ToadExporter.csproj" />
      <ProjectReference Include="..\ToadTools.Connection\ToadTools.Connection.csproj" />
      <ProjectReference Include="..\WarmSync\WarmSync.csproj" />
      <ProjectReference Include="..\WorkingSet\WorkingSet.csproj" />
      <ProjectReference Include="..\WorksetCheck\WorksetCheck.csproj" />
      <ProjectReference Include="..\WriteDash\WriteDash.csproj" />
    </ItemGroup>

</Project>
