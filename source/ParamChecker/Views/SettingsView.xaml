<UserControl
    x:Class="ParamChecker.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,8,0">
            <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,10" />

            <ui:Card Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Отчёты" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Папка для отчётов" Opacity="0.8" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding Settings.ReportsFolder, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                   ToolTip="Выбрать папку" Command="{Binding BrowseReportsCommand}" />
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Open24}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                   ToolTip="Открыть папку" Command="{Binding OpenReportsCommand}" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Отчёты раскладываются по папкам профилей: &lt;папка&gt;\&lt;профиль&gt;\&lt;модель&gt;_LOIReport.xlsx. Здесь же — журнал каждого запуска." />

                    <CheckBox Margin="0,10,0,0" Content="В листах правил — только элементы с незаполненными параметрами"
                              IsChecked="{Binding Settings.ProblemsOnly}" />
                    <TextBlock Margin="28,0,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Отчёты по большим моделям становятся в разы меньше и сразу показывают, что исправлять. Итоги и проценты считаются по всем элементам." />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Открытие моделей" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox Content="Не загружать связи RVT" IsChecked="{Binding Settings.SkipLinks}" />
                    <TextBlock Margin="28,0,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Модель копируется во временную папку, и в копии связи отключаются — так она открывается быстрее, а закрывать рабочие наборы связей не нужно. Исходная модель не меняется." />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="База для дашбордов (Power BI, Excel)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox Content="Дописывать итоги каждого запуска в базу" IsChecked="{Binding Settings.HistoryEnabled}" />
                    <TextBlock Margin="28,0,0,8" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Одна книга Excel с таблицами Models, Rules и Parameters: каждый запуск добавляет строки с датой, поэтому копится история заполнения. Её удобно подключить к Power BI один раз и обновлять." />
                    <Grid IsEnabled="{Binding Settings.HistoryEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding Settings.HistoryFile, UpdateSourceTrigger=LostFocus}"
                                    PlaceholderText="{Binding HistoryPlaceholder}"
                                    ToolTip="Пусто — ParamChecker_База.xlsx в папке отчётов. Можно указать общий файл на сетевом диске" />
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                   ToolTip="Выбрать файл" Command="{Binding BrowseHistoryCommand}" />
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Open24}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                   ToolTip="Открыть базу" Command="{Binding OpenHistoryCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Аналитика ToadFlow" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox Content="Отправлять итоги проверенных моделей в ToadFlow" IsChecked="{Binding Settings.ToadFlowEnabled}" />
                    <TextBlock Margin="28,0,0,8" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Ручные проверки попадут на страницу «Аналитика LOI» сервиса ToadFlow рядом с проверками по расписанию. Отправляются только итоги — без элементов. Если сервер недоступен, итоги ждут в очереди и уходят при следующей проверке." />
                    <Grid IsEnabled="{Binding Settings.ToadFlowEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding Settings.ToadFlowUrl, UpdateSourceTrigger=LostFocus}" PlaceholderText="http://toadflow:8080" />
                        <ui:PasswordBox Grid.Column="1" Margin="8,0,0,0" Password="{Binding Settings.ToadFlowToken, UpdateSourceTrigger=LostFocus}"
                                        PlaceholderText="Токен доступа" />
                        <ui:Button Grid.Column="2" Content="Проверить связь" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                   Command="{Binding TestToadFlowCommand}" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Токен создаётся в веб-интерфейсе ToadFlow: «Настройки → Токены доступа». В настройках он хранится зашифрованным для вашей учётной записи Windows." />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding ToadFlowQueue}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14,10" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Тема" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ui:ToggleSwitch IsChecked="{Binding Settings.DarkTheme, Mode=TwoWay}" OffContent="Светлая" OnContent="Тёмная" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="О плагине" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="ParamChecker открывает модели с Revit Server или с диска, отбирает элементы по правилам и проверяет, заполнены ли у них нужные параметры. Итог — отчёт Excel по каждой модели и база для дашбордов." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Справка" Icon="{ui:SymbolIcon QuestionCircle24}" Command="{Binding OpenHelpCommand}" />
                        <ui:Button Content="Написать разработчику" Icon="{ui:SymbolIcon Chat24}" Margin="8,0,0,0"
                                   Command="{Binding WriteDeveloperCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
