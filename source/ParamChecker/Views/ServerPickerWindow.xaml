<ui:FluentWindow
    x:Class="ParamChecker.Views.ServerPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ParamChecker.ViewModels"
    xmlns:views="clr-namespace:ParamChecker.Views"
    xmlns:uiConverters="clr-namespace:ToadTools.UI.Converters;assembly=ToadTools.UI"
    d:DataContext="{d:DesignInstance Type=viewModels:ServerPickerViewModel}"
    mc:Ignorable="d"
    Title="Модели с Revit Server"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Height="720"
    Width="820"
    MinHeight="480"
    MinWidth="640"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Строка дерева на всю ширину: отступ уровня — внутри строки, поэтому галочки ровные -->
        <Style x:Key="ServerTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="0,1"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NodeIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Cube20" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter Property="Symbol" Value="Folder20" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="Symbol" Value="ArrowSync20" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Модели с Revit Server" Icon="Server24" ShowMinimize="False" />

        <!-- Сервер -->
        <ui:Card Grid.Row="1" Margin="10,0,10,8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сервер" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Servers}"
                          Text="{Binding Server, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Серверы из RSN.ini; имя можно вписать вручную" />
                <TextBlock Grid.Column="2" Text="{Binding ServerVersionText}" Opacity="0.7" VerticalAlignment="Center" Margin="10,0" />
                <ui:Button Grid.Column="3" Content="Обновить" Icon="{ui:SymbolIcon ArrowSync24}" VerticalAlignment="Stretch"
                           ToolTip="Заново обойти сервер. Каталог хранится весь сеанс Revit и на диске, обновлять его нужно, только если на сервере появились новые модели"
                           Command="{Binding RefreshCommand}" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="Поиск по всему серверу — имя модели или папки" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding IsRefreshing, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}" />
            </StackPanel>
        </Grid>

        <ui:Card Grid.Row="3" Margin="10,0,10,0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:InfoBar Grid.Row="0" Margin="8" Severity="Warning" IsClosable="False" Title="Revit Server"
                            Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" />

                <!-- Дерево -->
                <TreeView Grid.Row="1" Margin="4,4,0,4" Padding="0" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Roots}" ItemContainerStyle="{StaticResource ServerTreeItem}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                          Visibility="{Binding IsSearching, Converter={uiConverters:InverseBooleanCollapsedVisibilityConverter}}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type viewModels:ServerNodeViewModel}" ItemsSource="{Binding Children}"
                                                  ItemContainerStyle="{StaticResource ServerTreeItem}">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={views:DepthIndentConverter}}">
                                    <ToggleButton Width="22" Height="22" Padding="0" MinWidth="0" Background="Transparent" BorderThickness="0"
                                                  IsChecked="{Binding IsExpanded}"
                                                  Visibility="{Binding IsFolder, Converter={uiConverters:BooleanHiddenVisibilityConverter}}">
                                        <ui:SymbolIcon FontSize="12">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="ChevronRight20" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Symbol" Value="ChevronDown20" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </ToggleButton>
                                    <CheckBox MinWidth="0" Margin="2,0,6,0" IsThreeState="False" IsChecked="{Binding IsChecked}"
                                              IsEnabled="{Binding IsExisting, Converter={uiConverters:InverseBooleanConverter}}"
                                              Visibility="{Binding IsPlaceholder, Converter={uiConverters:InverseBooleanHiddenVisibilityConverter}}" />
                                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Opacity="0.8" Style="{StaticResource NodeIcon}" />
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="8,0,0,0"
                                                     Visibility="{Binding IsLoading, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                           TextAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptyText}"
                           Visibility="{Binding Roots.Count, Converter={views:ZeroVisibleConverter}}" />

                <!-- Результаты поиска -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsSearching, Converter={uiConverters:BooleanCollapsedVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding SearchResults}" Margin="12,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ServerNodeViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" Margin="0,0,6,0" IsThreeState="False" IsChecked="{Binding IsChecked}"
                                              IsEnabled="{Binding IsExisting, Converter={uiConverters:InverseBooleanConverter}}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderPath}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Снять все" Appearance="Transparent" Command="{Binding ClearSelectionCommand}" />
            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="Галочка на папке отмечает все модели в ней и во вложенных папках." />
            <ui:Button Grid.Column="2" Content="Отмена" Icon="{ui:SymbolIcon Dismiss24}" IsCancel="True" Click="OnCancel" />
            <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="{Binding AddText}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                       Command="{Binding AcceptCommand}" Click="OnApply" />
        </Grid>
    </Grid>
</ui:FluentWindow>
