<toad:ToadWindow
    x:Class="ToadTools.UI.Views.ToadProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toad="urn:toaddesign"
    xmlns:converters="clr-namespace:ToadTools.UI.Converters"
    xmlns:viewModels="clr-namespace:ToadTools.UI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ToadProgressViewModel}"
    mc:Ignorable="d"
    Title="{Binding Title}"
    WindowStartupLocation="Manual"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    ShowActivated="True"
    Width="500"
    MinHeight="0"
    SizeToContent="Height"
    ShowMaximizeButton="False"
    ShowCloseButton="False"
    TitleIcon="{Binding Icon}">

    <toad:ToadWindow.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarValue}" />
    </toad:ToadWindow.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="1" Margin="20,4,20,18">

            <!-- Этап и общее время -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Stage}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Stage}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" Opacity="0.6"
                            VerticalAlignment="Center" ToolTip="Прошло времени">
                    <toad:Icon Symbol="Clock" Width="14" Height="14" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Elapsed}" />
                </StackPanel>
            </Grid>

            <!-- Общая полоса -->
            <Grid Margin="0,12,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Height="6"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Maximum="{Binding Maximum}"
                             Value="{Binding Value}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Percent}"
                           MinWidth="44"
                           Margin="10,0,0,0"
                           TextAlignment="Right"
                           Opacity="0.7"
                           Visibility="{Binding Percent, Converter={converters:StringVisibilityConverter}}" />
            </Grid>
            <TextBlock Text="{Binding Detail}" Opacity="0.7" TextTrimming="CharacterEllipsis" MinHeight="18"
                       ToolTip="{Binding Detail}" />

            <!-- Текущая задача (например, модель) -->
            <Border Margin="0,14,0,0"
                    Padding="14,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{DynamicResource Toad.Brush.Surface}"
                    BorderBrush="{DynamicResource Toad.Brush.Border}"
                    Visibility="{Binding ItemVisible, Converter={converters:BooleanCollapsedVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ItemTitle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ItemTitle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" Opacity="0.6"
                                    VerticalAlignment="Center" ToolTip="Время на текущую задачу"
                                    Visibility="{Binding ItemElapsed, Converter={converters:StringVisibilityConverter}}">
                            <toad:Icon Symbol="Hourglass" Width="14" Height="14" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ItemElapsed}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding ItemStatus}"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ItemStatus}"
                               Visibility="{Binding ItemStatus, Converter={converters:StringVisibilityConverter}}" />

                    <ProgressBar Margin="0,10,0,0"
                                 Height="4"
                                 IsIndeterminate="{Binding ItemIndeterminate}"
                                 Maximum="{Binding ItemMaximum}"
                                 Value="{Binding ItemValue}" />

                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding ItemCanSkip, Converter={converters:BooleanCollapsedVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource Toad.Brush.Warning}"
                                   Text="Пропускаем — Revit прервёт операцию при первой возможности"
                                   Visibility="{Binding IsSkipPending, Converter={converters:BooleanCollapsedVisibilityConverter}}" />
                        <toad:Button Grid.Column="1"
                                   Content="{Binding SkipText}"
                                   Icon="PlayerTrackNext"
                                   Command="{Binding SkipCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Прервать всё -->
            <Grid Margin="0,16,0,0"
                  Visibility="{Binding CanCancel, Converter={converters:BooleanCollapsedVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource Toad.Brush.Warning}"
                           Text="{Binding CancelHint}"
                           Visibility="{Binding IsCancelled, Converter={converters:BooleanCollapsedVisibilityConverter}}" />
                <toad:Button Grid.Column="1"
                           Content="Прервать"
                           Icon="X"
                           Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>
    </Grid>
</toad:ToadWindow>
