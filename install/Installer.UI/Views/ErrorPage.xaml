<UserControl x:Class="Installer.UI.Views.ErrorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toad="urn:toaddesign">
    <UserControl.Resources>
        <ResourceDictionary Source="/ToadTools.Installer.UI;component/Views/Shared.xaml" />
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="{StaticResource FooterMargin}" LastChildFill="False">
            <toad:Button DockPanel.Dock="Left" Variant="Subtle" Padding="10,0" Margin="-10,0,0,0" Content="Журнал установки"
                         Command="{Binding OpenCommand}" CommandParameter="log"
                         Visibility="{Binding HasLog, Converter={StaticResource Visible}}" />
            <toad:Button DockPanel.Dock="Right" Variant="Filled" Margin="8,0,0,0" Icon="Refresh" Content="Повторить"
                         Command="{Binding RetryCommand}" IsDefault="True" />
            <toad:Button DockPanel.Dock="Right" Content="Закрыть" Command="{Binding CloseCommand}" IsCancel="True" />
        </DockPanel>

        <StackPanel Margin="{StaticResource BodyMargin}">
            <TextBlock Style="{StaticResource Heading}" Text="{Binding ErrorTitle}" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding ErrorHint}" />
            <toad:Alert Severity="Error" Title="Установщик Windows сообщил об ошибке"
                        Visibility="{Binding HasErrorText, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" MaxHeight="150" TextTrimming="CharacterEllipsis" />
            </toad:Alert>
        </StackPanel>
    </DockPanel>
</UserControl>
