<toad:ToadWindow
    x:Class="SSPlan.Views.SSPlanView"
    xmlns:toad="urn:toaddesign"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="Структурная схема"
    Height="450"
    Width="450"
    MinHeight="450"
    MinWidth="400"
    TitleIcon="CirclePlus">

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <!-- Выбор панели -->
        <TextBlock Grid.Row="1" Text="Выберите панель"/>
        
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <ComboBox Grid.Column="0" Height="35"
                      ItemsSource="{Binding Panels}" 
                      SelectedItem="{Binding SelectedPanel, Mode=TwoWay}" 
                      DisplayMemberPath="Name"/>
            <toad:Button Grid.Column="1" Icon="Pointer"
                                       Margin="5,0,0,0"
                                       Height="35"
                                       Command="{Binding SelectPanelCommand}"/>
        </Grid>
        
        <!-- Выбор семейства -->
        
        <TextBlock Grid.Row="3" Text="Выберите семейство аннотации"
                                   Margin="0,10,0,0"/>
        
        <ComboBox Grid.Row="4" Margin="0,10,0,0"
                  ItemsSource="{Binding FamilyItems}" 
                  SelectedItem="{Binding SelectedFamily, Mode=TwoWay}" 
                  DisplayMemberPath="DisplayName"/>
        
        <!-- Выбор смещения -->
        <TextBlock Grid.Row="5" Text="Введите смещение по оси X"
                      Margin="0,10,0,0"/>
        <toad:TextBox Grid.Row="6" Placeholder="Введите смещение по оси X"
                                 Margin="0,10,0,0"
                                 Text="{Binding AxisX, Mode=TwoWay}"/>
        
        <TextBlock Grid.Row="7" Text="Введите смещение по оси Y"
                      Margin="0,10,0,0"/>
        <toad:TextBox Grid.Row="8" Placeholder="Введите смещение по оси Y"
                                 Margin="0,10,0,0"
                                 Text="{Binding AxisY, Mode=TwoWay}"/>
        

        <!-- Кнопка действия -->
        <StackPanel Grid.Row="9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
            <toad:Button Content="Создать"
                       Command="{Binding RunCommand}"
                       Icon="PlayerPlay"
                       Variant="Filled"
                       Width="160"
                       Height="40"
                       Margin="0,0,0,20"/>
        </StackPanel>

        <!-- Переключатель темы -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0">
            <toad:Switch Content="Тёмная тема"
                IsChecked="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=toad:ToadWindow}, Mode=TwoWay}"/>
        </StackPanel>

    </Grid>
</toad:ToadWindow>