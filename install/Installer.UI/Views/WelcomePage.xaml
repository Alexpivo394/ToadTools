<UserControl x:Class="Installer.UI.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toad="urn:toaddesign">
    <UserControl.Resources>
        <ResourceDictionary Source="/ToadTools.Installer.UI;component/Views/Shared.xaml" />
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="{StaticResource FooterMargin}" LastChildFill="False">
            <!-- New installation: what's new; upgrade: the Revit versions with "Изменить" -->
            <toad:Button DockPanel.Dock="Left" Variant="Subtle" Padding="10,0" Margin="-10,0,0,0"
                         Content="{Binding Info.Version}" ContentStringFormat="Что нового в {0}"
                         Command="{Binding OpenCommand}" CommandParameter="release"
                         Visibility="{Binding IsUpgrade, Converter={StaticResource Hidden}}" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                        Visibility="{Binding IsUpgrade, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding UpgradeHint}" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource Toad.Brush.TextDimmed}" />
                <toad:Button Variant="Subtle" Padding="8,0" Margin="2,0,0,0" Content="Изменить"
                             Command="{Binding ShowVersionsCommand}" />
            </StackPanel>
            <toad:Button DockPanel.Dock="Right" Variant="Filled" Margin="8,0,0,0" Icon="Download"
                         Content="{Binding InstallText}" Command="{Binding InstallCommand}" IsDefault="True" />
            <toad:Button DockPanel.Dock="Right" Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" />
        </DockPanel>

        <StackPanel Margin="{StaticResource BodyMargin}">
            <DockPanel Margin="0,8,0,18">
                <Image Style="{StaticResource Logo}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0"
                               Visibility="{Binding IsUpgrade, Converter={StaticResource Hidden}}"
                               Text="Инструменты для Revit: проверка и заполнение параметров, рабочие наборы, пакетная выгрузка моделей, кабельные лотки, коллизии из ToadFlow." />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsUpgrade, Converter={StaticResource Visible}}">
                        <toad:Badge Tone="Neutral" Content="{Binding Info.PreviousVersion}" />
                        <toad:Icon Symbol="ArrowRight" Margin="8,0" Foreground="{DynamicResource Toad.Brush.TextDimmed}" />
                        <toad:Badge Content="{Binding Info.Version}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- New installation -->
            <StackPanel Visibility="{Binding IsUpgrade, Converter={StaticResource Hidden}}">
                <toad:Card Icon="BuildingSkyscraper" Header="{Binding SelectionTitle}" Description="{Binding SelectionHint}">
                    <toad:Card.TrailingContent>
                        <toad:Button Variant="Subtle" Content="Изменить" Command="{Binding ShowVersionsCommand}" />
                    </toad:Card.TrailingContent>
                </toad:Card>
                <toad:Card Icon="User" Margin="0,8,0,0" Header="{Binding ScopeTitle}" Description="{Binding ScopeHint}" />
            </StackPanel>

            <!-- Upgrade -->
            <StackPanel Visibility="{Binding IsUpgrade, Converter={StaticResource Visible}}">
                <StackPanel Visibility="{Binding HasHighlights, Converter={StaticResource Visible}}">
                    <TextBlock Text="Что нового" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Info.Highlights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Ellipse Width="5" Height="5" Margin="4,8,10,0" VerticalAlignment="Top"
                                             Fill="{DynamicResource Toad.Brush.Accent}" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <toad:Button Variant="Subtle" HorizontalAlignment="Left" Padding="10,0" Margin="-10,4,0,0"
                             Content="Все изменения" Command="{Binding OpenCommand}" CommandParameter="changelog" />
            </StackPanel>

            <toad:Alert Severity="Warning" Margin="0,12,0,0" Title="{Binding BlockTitle}" Content="{Binding BlockText}"
                        Visibility="{Binding IsBlocked, Converter={StaticResource Visible}}" />
        </StackPanel>
    </DockPanel>
</UserControl>
